  <!-- Custom Build: Compile Shaders -->
  <Target Name="CompileShaders" BeforeTargets="ClCompile">
    <PropertyGroup>
      <GlslcExecutable Condition="'$(GlslcExecutable)'==''">$(GLSLC)</GlslcExecutable>
      <GlslcExecutable Condition="'$(GlslcExecutable)'==''">$(VulkanSDK)\Bin\glslc.exe</GlslcExecutable>
    </PropertyGroup>
    <Error Condition="'$(GlslcExecutable)'==''" Text="glslc path not configured. Set VULKAN_SDK environment variable (or define GlslcExecutable/GLSLC) before building ozz_animation_viewer." />
    <Error Condition="!Exists('$(GlslcExecutable)')" Text="glslc not found at &quot;$(GlslcExecutable)&quot;. Update VULKAN_SDK or set GlslcExecutable to the Vulkan shader compiler." />
    <MakeDir Directories="$(ShaderOutputDir)" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\triangle.vert&quot; -o &quot;$(ShaderOutputDir)triangle.vert.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\triangle.frag&quot; -o &quot;$(ShaderOutputDir)triangle.frag.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\skeleton_instanced.vert&quot; -o &quot;$(ShaderOutputDir)skeleton_instanced.vert.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\skeleton_instanced.frag&quot; -o &quot;$(ShaderOutputDir)skeleton_instanced.frag.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\debug_lines.vert&quot; -o &quot;$(ShaderOutputDir)debug_lines.vert.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\debug_lines.frag&quot; -o &quot;$(ShaderOutputDir)debug_lines.frag.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\shaded_bone.vert&quot; -o &quot;$(ShaderOutputDir)shaded_bone.vert.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\shaded_bone.frag&quot; -o &quot;$(ShaderOutputDir)shaded_bone.frag.spv&quot;" />
    <Exec Command="&quot;$(GlslcExecutable)&quot; &quot;$(ProjectDir)renderer\shaders\skinned_mesh_instanced.vert&quot; -o &quot;$(ShaderOutputDir)skinned_mesh_instanced.vert.spv&quot;" />
