  <Target Name="ConfigureAndBuildONNXRuntime" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)'!='Release Master Gold'">
    <PropertyGroup>
      <ONNXRuntimeDir>$(xrExternals)onnxruntime</ONNXRuntimeDir>
      <ONNXRuntimeBuildDir>$(ONNXRuntimeDir)\vs_build</ONNXRuntimeBuildDir>
      <!-- CUDA/cuDNN/TensorRT paths: Use environment variables if set, otherwise use detected defaults -->
      <!-- Users can override by setting: CUDA_HOME, CUDNN_HOME, TENSORRT_HOME environment variables -->
      <CudaHome Condition="'$(CUDA_HOME)'!=''">$(CUDA_HOME)</CudaHome>
      <CudaHome Condition="'$(CUDA_HOME)'==''">C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.6</CudaHome>
      <CudnnHome Condition="'$(CUDNN_HOME)'!=''">$(CUDNN_HOME)</CudnnHome>
      <CudnnHome Condition="'$(CUDNN_HOME)'==''">C:\Program Files\NVIDIA GPU Computing Toolkit\CUDNN\v9.16.0.29</CudnnHome>
      <TensorRTHome Condition="'$(TENSORRT_HOME)'!=''">$(TENSORRT_HOME)</TensorRTHome>
      <TensorRTHome Condition="'$(TENSORRT_HOME)'==''">C:\Program Files\NVIDIA GPU Computing Toolkit\TensorRT-10.14.1.48</TensorRTHome>
      <ONNXCMakeOptions>-DONNX_USE_MSVC_STATIC_RUNTIME=OFF -Dprotobuf_MSVC_STATIC_RUNTIME=OFF -Donnxruntime_BUILD_SHARED_LIB=ON -Donnxruntime_BUILD_UNIT_TESTS=OFF -Donnxruntime_USE_DML=OFF -Donnxruntime_USE_CUDA=ON -Donnxruntime_USE_TENSORRT=ON -Donnxruntime_CUDA_HOME="$(CudaHome)" -Donnxruntime_CUDNN_HOME="$(CudnnHome)" -Donnxruntime_TENSORRT_HOME="$(TensorRTHome)" "-DCMAKE_CXX_FLAGS=/MD /MP" "-DCMAKE_CXX_FLAGS_RELEASE=/MD /O2 /Ob2 /DNDEBUG" "-DCMAKE_CXX_FLAGS_RELWITHDEBINFO=/MD /Zi /O2 /Ob1 /DNDEBUG"</ONNXCMakeOptions>
      <!-- Map OpenXRay configurations to ONNX Runtime build configs -->
      <ONNXConfig Condition="'$(Configuration)'=='Debug'">RelWithDebInfo</ONNXConfig>
      <ONNXConfig Condition="'$(Configuration)'=='Mixed'">RelWithDebInfo</ONNXConfig>
      <ONNXConfig Condition="'$(Configuration)'=='Release'">Release</ONNXConfig>
      <ONNXConfig Condition="'$(Configuration)'=='Release Master Gold'">Release</ONNXConfig>
      <ONNXParallelCount>$([System.Environment]::ProcessorCount)</ONNXParallelCount>
    </PropertyGroup>
    <!-- Display detected/configured paths -->
    <Message Text="[ONNX Runtime] CUDA Path: $(CudaHome)" Importance="high" />
    <Message Text="[ONNX Runtime] cuDNN Path: $(CudnnHome)" Importance="high" />
    <Message Text="[ONNX Runtime] TensorRT Path: $(TensorRTHome)" Importance="high" />
    <Message Text="[ONNX Runtime] Tip: Override with CUDA_HOME, CUDNN_HOME, TENSORRT_HOME environment variables" Importance="normal" />
    <!-- Configure ONNX Runtime with CMake if vs_build doesn't exist -->
    <Exec Command="cmake -A x64 $(ONNXCMakeOptions) -S $(ONNXRuntimeDir)\cmake -B $(ONNXRuntimeBuildDir)" Condition="!Exists('$(ONNXRuntimeBuildDir)\onnxruntime.sln')" />
    <!-- Build ONNX Runtime + CUDA/TensorRT providers for current configuration with parallel jobs -->
    <Message Text="[ONNX Runtime Build] Processor Count: $(ONNXParallelCount)" Importance="high" />
    <Message Text="[ONNX Runtime Build] Building: onnxruntime + providers (CUDA, TensorRT, shared)" Importance="high" />
    <Exec Command="cmake --build $(ONNXRuntimeBuildDir) --config $(ONNXConfig) --target onnxruntime onnxruntime_providers_cuda onnxruntime_providers_tensorrt onnxruntime_providers_shared --parallel $(ONNXParallelCount)" Condition="Exists('$(ONNXRuntimeBuildDir)\onnxruntime.sln')" />
    <!-- Copy ONNX Runtime DLLs to output directory -->
    <Message Text="[ONNX Runtime] Copying DLLs to $(OutDir)" Importance="high" />
    <Copy SourceFiles="$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime.dll')" />
    <Copy SourceFiles="$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_shared.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_shared.dll')" />
    <Copy SourceFiles="$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_cuda.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_cuda.dll')" />
    <Copy SourceFiles="$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_tensorrt.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_tensorrt.dll')" />
    <Warning Text="[ONNX Runtime] WARNING: onnxruntime_providers_cuda.dll not found - CUDA support will not be available!" Condition="!Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_cuda.dll')" />
    <Warning Text="[ONNX Runtime] WARNING: onnxruntime_providers_tensorrt.dll not found - TensorRT support will not be available!" Condition="!Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_tensorrt.dll')" />
    <!-- Copy CUDA/cuDNN/TensorRT runtime dependencies if CUDA provider was built -->
    <!-- This ensures the engine works without requiring users to modify PATH -->
    <ItemGroup Condition="Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_cuda.dll')">
      <!-- CUDA Runtime DLLs -->
      <CudaRuntimeDlls Include="$(CudaHome)\bin\cudart64_12.dll" />
      <CudaRuntimeDlls Include="$(CudaHome)\bin\cublas64_12.dll" />
      <CudaRuntimeDlls Include="$(CudaHome)\bin\cublasLt64_12.dll" />
      <CudaRuntimeDlls Include="$(CudaHome)\bin\cufft64_11.dll" />
      <CudaRuntimeDlls Include="$(CudaHome)\bin\cusparse64_12.dll" />
      <!-- cuDNN DLLs -->
      <CudnnDlls Include="$(CudnnHome)\bin\cudnn64_9.dll" />
      <CudnnDlls Include="$(CudnnHome)\bin\cudnn_ops_infer64_9.dll" />
      <CudnnDlls Include="$(CudnnHome)\bin\cudnn_cnn_infer64_9.dll" />
      <CudnnDlls Include="$(CudnnHome)\bin\cudnn_adv_infer64_9.dll" />
      <CudnnDlls Include="$(CudnnHome)\bin\cudnn_graph64_9.dll" />
      <!-- TensorRT DLLs (in bin directory with _10 suffix for v10) -->
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvinfer_10.dll" />
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvinfer_plugin_10.dll" />
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvonnxparser_10.dll" />
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvinfer_lean_10.dll" />
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvinfer_dispatch_10.dll" />
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvinfer_vc_plugin_10.dll" />
      <!-- Also include the builder resource DLLs for your GPU architecture -->
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvinfer_builder_resource_sm86_10.dll" />
      <!-- RTX 3080 is SM86 -->
      <TensorRTDlls Include="$(TensorRTHome)\bin\nvinfer_builder_resource_ptx_10.dll" />
      <!-- PTX for JIT compilation -->
    </ItemGroup>
    <Copy SourceFiles="@(CudaRuntimeDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
    <Copy SourceFiles="@(CudnnDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
    <Copy SourceFiles="@(TensorRTDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
    <Message Text="[ONNX Runtime] Copied CUDA/cuDNN/TensorRT runtime DLLs for zero-config GPU acceleration" Importance="high" Condition="Exists('$(ONNXRuntimeBuildDir)\$(ONNXConfig)\onnxruntime_providers_cuda.dll')" />
  </Target>
