  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="..\xray.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>XR_NETSERVER_EXPORTS;STEAMNETWORKINGSOCKETS_STATIC_LINK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Ensure GNS + protobuf are built via CMake before xrNetServer's link step.
       CMake is invoked directly (no bash). If the build dir has not been configured
       yet, run cmake-initial-configure first manually; this target only (re)builds
       the externals into the matching $(xrCMakeBuildDir). -->
  <Target Name="xrBuildNetExternals"
          BeforeTargets="ClCompile"
          Condition="Exists('$(xrCMakeBuildDir)build.ninja') And !Exists('$(xrCMakeBuildDir)Externals\GameNetworkingSockets\src\GameNetworkingSockets_s.lib')">
    <Message Importance="high" Text="[xrNetServer] Building GameNetworkingSockets + protobuf via CMake in $(xrCMakeBuildDir)" />
    <Exec Command='cmake --build "$(xrCMakeBuildDir.TrimEnd(`\`))" --target GameNetworkingSockets_s libprotobuf'
          WorkingDirectory="$(SolutionDir).." />
  </Target>

  <Target Name="xrWarnMissingCMakeBuild"
          BeforeTargets="ClCompile"
          Condition="!Exists('$(xrCMakeBuildDir)build.ninja')">
    <Warning Text="[xrNetServer] $(xrCMakeBuildDir) has not been configured. Run ./cmake-initial-configure from the repo root so GameNetworkingSockets + protobuf can be built before xr_3da.exe links." />
  </Target>
