#include "common.h"
#include "sload.h"

// Phase 6: Shadertoy-inspired lighting parameters
static const float3 youngGrassCol = float3(0.35, 0.45, 0.18);  // Brighter, more vibrant
static const float3 oldGrassCol = float3(0.28, 0.38, 0.15);    // Slightly duller
static const float3 sunCol = float3(1.0, 0.95, 0.85);          // Warm sunlight
static const float3 skyCol = float3(0.4, 0.5, 0.65);           // Cool sky

// Phase 6: Calculate height-based AO with improved curve
float CalculateGrassAO(float t)
{
    // Smoother AO transition from base to tip
    // Base (t=0) is darker, tip (t=1) is fully lit
    float ao_base = 0.4;  // Not too dark at base
    float ao_range = 0.6; // Range to full brightness
    return ao_base + ao_range * pow(saturate(t), 0.4);  // Gentler curve
}

// Phase 6: Two-sided diffuse with wrap lighting (subsurface scattering approximation)
float CalculateWrappedDiffuse(float3 N, float3 L)
{
    // Wrap lighting simulates subsurface scattering
    // Grass is translucent and lights from both sides
    float NdotL = dot(N, L);
    float wrap = 0.5;  // Wrap amount (0.5 = moderate subsurface)
    return saturate((NdotL + wrap) / (1.0 + wrap));
}

// Phase 6: Specular highlight (grass has subtle sheen when wet or healthy)
float CalculateGrassSpecular(float3 N, float3 L, float3 V, float ao)
{
    float3 H = normalize(L + V);
    float NdotH = saturate(dot(N, H));

    // Anisotropic-style specular (grass blades have directional highlights)
    float roughness = 0.6;  // Moderate roughness
    float spec_power = 1.0 / (roughness * roughness + 0.0001);
    float spec = pow(NdotH, spec_power);

    // Specular is stronger at tips (fresher, healthier grass)
    return spec * ao * 0.15;  // Subtle specular contribution
}

// Phase 6: Improved fresnel with proper view-dependent rim lighting
float3 CalculateFresnel(float3 N, float3 V, float ao)
{
    // Fresnel for rim lighting (edges catch more sky light)
    float fresnel_term = pow(saturate(1.0 - dot(N, V)), 2.5);

    // Greenish-blue rim from sky
    float3 rim_color = float3(0.15, 0.25, 0.18);
    return rim_color * ao * fresnel_term * 0.8;
}

// Phase 6: Hemisphere ambient lighting (sky + ground bounce)
float3 CalculateAmbient(float3 N, float ao)
{
    // Sky contribution (from above)
    float sky_amount = saturate(N.y * 0.5 + 0.5);
    float3 sky_ambient = skyCol * sky_amount * 0.3;

    // Ground bounce (from below) - brown/earth tone
    float ground_amount = saturate(-N.y * 0.5 + 0.5);
    float3 ground_color = float3(0.25, 0.20, 0.15);
    float3 ground_ambient = ground_color * ground_amount * 0.15;

    return (sky_ambient + ground_ambient) * ao;
}

// Phase 5: Grass interaction debug visualization
Texture2D s_interaction_atlas;
uniform int dm_debug_trails;

float SampleGrassInteraction(float2 atlas_uv)
{
    float4 interaction = s_interaction_atlas.Sample(smp_base, atlas_uv);
    return interaction.r;
}

f_deffer main(p_flat I)
{
    f_deffer O;

    // ===== PHASE 6: Enhanced Grass Lighting =====

    // Normalize inputs
    float3 N = normalize(I.N);
    float3 V = normalize(-I.position.xyz);
    float3 L = normalize(mul((float3x3)m_V, L_sun_dir_w));

    // Height-based AO and color variation
    float t = I.heightParam;
    float ao = CalculateGrassAO(t);

    // Color variation: mix young/old grass based on height and position
    // Higher parts of blade are younger (greener), lower parts older
    float color_blend = smoothstep(0.3, 0.7, t);
    float3 grassCol = lerp(oldGrassCol, youngGrassCol, color_blend);

    // Add subtle per-blade variation using world position hash
    float hash = frac(sin(dot(I.position.xz, float2(12.9898, 78.233))) * 43758.5453);
    grassCol *= lerp(0.9, 1.1, hash);  // ±10% color variation

    // === LIGHTING COMPONENTS ===

    // 1. Wrapped diffuse (subsurface scattering approximation)
    float wrapped_diffuse = CalculateWrappedDiffuse(N, L);
    float3 diffuse = grassCol * sunCol * wrapped_diffuse;

    // 2. Specular highlight (subtle sheen)
    float specular = CalculateGrassSpecular(N, L, V, ao);
    float3 spec_contrib = sunCol * specular;

    // 3. Ambient lighting (sky + ground)
    float3 ambient = CalculateAmbient(N, ao);

    // 4. Fresnel rim lighting
    float3 fresnel = CalculateFresnel(N, V, ao);

    // === FINAL COMPOSITION ===

    // Combine all lighting components
    float3 finalColor = diffuse * ao           // Main diffuse with AO
                      + spec_contrib            // Specular highlights
                      + ambient                 // Hemisphere ambient
                      + fresnel;                // Rim lighting

    // Exposure and tonemapping adjustment
    finalColor *= 1.1;  // Slight brightness boost
    finalColor = pow(finalColor, 0.9);  // Subtle gamma adjustment for richness

    // Phase 5: Debug visualization
    if (dm_debug_trails > 0)
    {
        float interaction_strength = SampleGrassInteraction(I.interaction_uv);
        finalColor = lerp(finalColor, float3(1.0, 0.0, 0.0), interaction_strength);
    }

    O = pack_gbuffer(
        float4(N, 0.5),
        float4(I.position.xyz, 0.5),
        float4(finalColor, 0.5)
    );

    return O;
}
