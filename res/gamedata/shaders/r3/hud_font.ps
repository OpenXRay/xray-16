#include "common.h"

struct 	v2p
{
 	half2 	tc0: 	TEXCOORD0;	
 	half4	c0:		COLOR0;
};

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main ( p_TL I ) : SV_Target
{
	float glyph_alpha = s_base.Sample( smp_base, I.Tex0 ).r;
	return float4(I.Color.rgb, glyph_alpha * I.Color.a);
}