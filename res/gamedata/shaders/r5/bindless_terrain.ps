// bindless_terrain.ps
// SM6 Bindless terrain pixel shader with 4-layer detail blending
// Uses RGBA mask for terrain detail texture blending
// TerrainMaterialData contains 14 texture descriptor indices

#define SM_6_0
#define CLUSTERED_LIGHTING_FORWARD
#include "common.h"
#include "bindless_common.h"
#include "shared/parallax.h"
#include "shared/terrain_blend.h"
#include "shared/surface_marks.h"

struct PS_INPUT
{
    float4 position : SV_Position;
    float3 worldPos : TEXCOORD0;
    float2 texcoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 bitangent : TEXCOORD4;
    nointerpolation uint materialID : TEXCOORD5;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

// ═══════════════════════════════════════════════════════
//  TERRAIN TEXTURE SAMPLING
// ═══════════════════════════════════════════════════════

// Sample terrain texture with fallback for invalid index
float4 SampleTerrainBase(uint index, float2 uv)
{
    if (index == INVALID_TEXTURE_INDEX)
        return float4(0.5, 0.5, 0.5, 1.0);
    return GetBindlessTexture(index).Sample(smp_linear, uv);
}

float4 SampleTerrainTexture(uint index, float2 uv)
{
    if (index == INVALID_TEXTURE_INDEX)
        return float4(0.5, 0.5, 0.5, 1.0);
    return GetBindlessTexture(index).Sample(smp_base, uv);
}

float4 SampleTerrainBump(uint index, float2 uv)
{
    if (index == INVALID_TEXTURE_INDEX)
        return float4(0.5, 0.5, 1.0, 0.0);
    return GetBindlessTexture(index).Sample(smp_base, uv).wzyx;
}

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    // Get terrain material data
    TerrainMaterialData mat = g_TerrainMaterials[input.materialID];

    // Base UV (low-frequency for base texture and mask)
    float2 baseUV = input.texcoord;

    // Detail UV (high-frequency for detail textures)
    float2 detailUV = input.texcoord * mat.detailScale;

    // ═══════════════════════════════════════════════════════
    //  SAMPLE BASE TEXTURE AND MASK
    // ═══════════════════════════════════════════════════════

    float4 baseSample = SampleTerrainBase(mat.baseAlbedoIndex, baseUV);
    float4 mask = TerrainNormalizeMask(SampleTerrainBase(mat.blendMaskIndex, baseUV));

    detailUV = ApplyTerrainParallaxUV(mat, mask, detailUV, input.tangent, input.bitangent, input.normal, input.worldPos);

    float4 detailR = SampleTerrainTexture(mat.detailR_Index, detailUV);
    float4 detailG = SampleTerrainTexture(mat.detailG_Index, detailUV);
    float4 detailB = SampleTerrainTexture(mat.detailB_Index, detailUV);
    float4 detailA = SampleTerrainTexture(mat.detailA_Index, detailUV);
    float3 blendedDetail = TerrainBlendRGB(detailR.rgb, detailG.rgb, detailB.rgb, detailA.rgb, mask);
    float3 albedo = baseSample.rgb * blendedDetail * 2.0;

    float3 N = normalize(input.normal);
    float4 nRt = SampleTerrainBump(mat.normalR_Index, detailUV);
    float4 nGt = SampleTerrainBump(mat.normalG_Index, detailUV);
    float4 nBt = SampleTerrainBump(mat.normalB_Index, detailUV);
    float4 nAt = SampleTerrainBump(mat.normalA_Index, detailUV);
    float3 mixN =
        (nRt.xyz - 0.5) * mask.r +
        (nGt.xyz - 0.5) * mask.g +
        (nBt.xyz - 0.5) * mask.b +
        (nAt.xyz - 0.5) * mask.a;
    mixN.z *= 0.5;
    float3x3 TBN = float3x3(
        normalize(input.tangent),
        normalize(input.bitangent),
        N
    );
    float3 Nt = normalize(mul(mixN, TBN));
    if (all(isfinite(Nt)) && dot(Nt, N) > 0.2)
        N = Nt;

    // ═══════════════════════════════════════════════════════
    //  4-LAYER DETAIL BLENDING (PBR) - Optional
    // ═══════════════════════════════════════════════════════

    float metallic = 0.0;
    float roughness = 0.5;
    float ao = 1.0;

    if (mat.flags & MAT_FLAG_HAS_PBR_LAYER)
    {
        float3 pbrR = SampleTerrainTexture(mat.pbrR_Index, detailUV).rgb;
        float3 pbrG = SampleTerrainTexture(mat.pbrG_Index, detailUV).rgb;
        float3 pbrB = SampleTerrainTexture(mat.pbrB_Index, detailUV).rgb;
        float3 pbrA = SampleTerrainTexture(mat.pbrA_Index, detailUV).rgb;
        float3 blendedPBR = TerrainBlendRGB(pbrR, pbrG, pbrB, pbrA, mask);
        metallic = blendedPBR.r;
        roughness = blendedPBR.g;
        ao = blendedPBR.b;
    }

    // ═══════════════════════════════════════════════════════
    //  LIGHTING
    // ═══════════════════════════════════════════════════════

    float hemi = saturate(0.5 + 0.5 * N.y);
    f_forward fwd = output_forward_pbr(
        albedo, N, input.worldPos, metallic, roughness, ao, input.position, hemi, 1.0, false);
    output.color = float4(fwd.color.rgb, 1.0);
    output.normal = fwd.normal;
    output.baseColor = float4(fwd.baseColor.rgb, PackBaseColorA(metallic, 0.0));
    output.worldPos = float4(input.worldPos, SURF_MARK_TERRAIN);
    return output;
}
