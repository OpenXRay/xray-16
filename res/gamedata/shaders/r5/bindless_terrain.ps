// bindless_terrain.ps
// SM6 Bindless terrain: 4-layer splat + height blend + POM (SSFX Terrain Upgrade)
// Puddles: modest in-shader gloss/albedo (screen-space wet owns cover/occlusion).

#define SM_6_0
#define CLUSTERED_LIGHTING_FORWARD
#define CSM_SHADOW_FORWARD
#define LOCAL_SHADOW_FORWARD
#define SKY_IBL
#define SKY_IBL_SPEC_V4 1
#define TERRAIN_WET_MARK 1
#include "common.h"
#include "bindless_common.h"

// settings_screenspace_TERRAIN.h (SSFX Update 23)
#ifndef TERRAIN_POM_STEPS_MAX
#define TERRAIN_POM_STEPS_MAX    12
#endif
#ifndef TERRAIN_POM_STEPS_MIN
#define TERRAIN_POM_STEPS_MIN    3
#endif
#ifndef TERRAIN_POM_AO
#define TERRAIN_POM_AO           0.125
#endif
#ifndef TERRAIN_POM_PLANE
#define TERRAIN_POM_PLANE        0.5
#endif
#ifndef TERRAIN_POM_RANGE
#define TERRAIN_POM_RANGE        20.0
#endif

struct PS_INPUT
{
    float4 position : SV_Position;
    float3 worldPos : TEXCOORD0;
    float2 texcoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 bitangent : TEXCOORD4;
    nointerpolation uint materialID : TEXCOORD5;
    float hemi : TEXCOORD6;
    float2 lmUV : TEXCOORD7;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

float4 SampleTerrainTexture(uint index, float2 uv)
{
    if (index == INVALID_TEXTURE_INDEX)
        return float4(0.5, 0.5, 0.5, 1.0);
    return GetBindlessTexture(index).Sample(smp_linear, uv);
}

float SampleTerrainHeightClassic(uint bumpXIdx, float2 uv)
{
    if (bumpXIdx == INVALID_TEXTURE_INDEX)
        return 0.5;
    float4 h = GetBindlessTexture(bumpXIdx).SampleLevel(smp_linear, uv, 0);
    return saturate(max(h.a, h.r));
}

float SampleTerrainHeightIxray(uint bumpIdx, float2 uv)
{
    if (bumpIdx == INVALID_TEXTURE_INDEX)
        return 0.5;
    return saturate(GetBindlessTexture(bumpIdx).SampleLevel(smp_linear, uv, 0).r);
}

float4 SampleTerrainHeights(TerrainMaterialData mat, float2 uv, bool ixrayPbs)
{
    if (ixrayPbs)
    {
        return float4(
            SampleTerrainHeightIxray(mat.normalR_Index, uv),
            SampleTerrainHeightIxray(mat.normalG_Index, uv),
            SampleTerrainHeightIxray(mat.normalB_Index, uv),
            SampleTerrainHeightIxray(mat.normalA_Index, uv));
    }
    return float4(
        SampleTerrainHeightClassic(mat.normalXR_Index, uv),
        SampleTerrainHeightClassic(mat.normalXG_Index, uv),
        SampleTerrainHeightClassic(mat.normalXB_Index, uv),
        SampleTerrainHeightClassic(mat.normalXA_Index, uv));
}

// SSFX HeightBlending — weight mask by layer height
float4 HeightBlendMask(float4 heights, float4 weights)
{
    float4 H = heights + weights;
    float Hmax = max(max(H.x, H.y), max(H.z, H.w)) - 1.01;
    float4 cut = max(heights - Hmax, 0.0) * weights;
    float sum = dot(cut, 1.0);
    if (sum < 1e-4)
        return weights;
    return cut / sum;
}

float BlendTerrainHeight(TerrainMaterialData mat, float4 mask, float2 uv, bool ixrayPbs)
{
    float4 h = SampleTerrainHeights(mat, uv, ixrayPbs);
    return saturate(dot(h, mask));
}

float2 TerrainPOM(TerrainMaterialData mat, float4 mask, float2 detailUV,
                  float3 T, float3 B, float3 N, float3 worldPos, bool ixrayPbs, out float heightAO)
{
    heightAO = 1.0;
    bool hasHeight = ixrayPbs
        ? ((mat.normalR_Index != INVALID_TEXTURE_INDEX) || (mat.normalG_Index != INVALID_TEXTURE_INDEX))
        : ((mat.flags & MAT_FLAG_HAS_NORMAL_X) != 0);
    if (!hasHeight)
        return detailUV;

    float3 V = normalize(eye_position - worldPos);
    float3 Vts = float3(dot(V, T), dot(V, B), dot(V, N));
    Vts = normalize(Vts);
    if (Vts.z < 0.01)
        return detailUV;

    float viewZ = abs(mul(m_V, float4(worldPos, 1.0)).z);
    if (viewZ >= TERRAIN_POM_RANGE)
        return detailUV;

    float heightScale = (parallax.x > 0.0) ? parallax.x : 0.013;
    float nNumSteps = lerp((float)TERRAIN_POM_STEPS_MAX, (float)TERRAIN_POM_STEPS_MIN, saturate(Vts.z));
    float fStepSize = 1.0 / nNumSteps;
    float2 vDelta = Vts.xy * (-heightScale) * 1.2;
    float2 vTexOffsetPerStep = fStepSize * vDelta;

    float2 vTexCurrentOffset = detailUV;
    float fCurrHeight = 0.0;
    float fCurrentBound = 1.0;
    float prevSam = 0.0;
    float currSam = BlendTerrainHeight(mat, mask, detailUV, ixrayPbs);

    [loop]
    for (int i = 0; i < (int)nNumSteps; ++i)
    {
        float layerH = TERRAIN_POM_PLANE - currSam * saturate(dot(mask, 1.0));
        if (layerH > fCurrentBound)
            break;
        prevSam = currSam;
        vTexCurrentOffset += vTexOffsetPerStep;
        fCurrentBound -= fStepSize;
        currSam = BlendTerrainHeight(mat, mask, vTexCurrentOffset, ixrayPbs);
        fCurrHeight = layerH;
    }

    // Contact refine interpolate
    float prevH = TERRAIN_POM_PLANE - prevSam;
    float currH = TERRAIN_POM_PLANE - currSam;
    float denom = (fCurrentBound + fStepSize - prevH) - (fCurrentBound - currH);
    float ratio = (abs(denom) > 1e-5)
        ? saturate((fCurrentBound + fStepSize - prevH) / denom)
        : 0.5;
    float2 resultUV = lerp(vTexCurrentOffset, vTexCurrentOffset - vTexOffsetPerStep, ratio);
    float hFinal = lerp(currSam, prevSam, ratio);
    heightAO = saturate(1.0 - hFinal * hFinal * TERRAIN_POM_AO);

    float fade = 1.0 - saturate(viewZ / TERRAIN_POM_RANGE);
    return lerp(detailUV, resultUV, fade);
}

void SampleTerrainBump(uint normalIdx, uint normalXIdx, float2 uv, float weight,
    inout float3 Nts, inout float gloss, bool ixrayPbs)
{
    if (normalIdx == INVALID_TEXTURE_INDEX || weight < 1e-5)
        return;

    float4 Nu = GetBindlessTexture(normalIdx).Sample(smp_linear, uv);
    if (ixrayPbs)
    {
        float2 nxy = Nu.wy * 2.0 - 1.0;
        float nz = sqrt(max(0.0, 1.0 - saturate(dot(nxy, nxy))));
        Nts += float3(nxy, nz) * weight;
        if (normalXIdx != INVALID_TEXTURE_INDEX)
        {
            float rough = GetBindlessTexture(normalXIdx).Sample(smp_linear, uv).y;
            gloss += saturate(1.0 - rough) * weight;
        }
        else
            gloss += 0.15 * weight;
    }
    else
    {
        float4 nPacked = Nu.wzyx;
        Nts += (nPacked.xyz - 0.5) * weight;
        gloss += nPacked.w * weight;
    }
}

// Modest terrain puddles (SSFX-inspired). Rain in fog_color.w.
float TerrainPuddle(float3 worldPos, float3 Nworld, float rain)
{
    if (rain < 0.001)
        return 0.0;
    float up = saturate(Nworld.y);
    // Flattened surfaces only
    float slope = saturate((up - 0.85) * 6.0);
    float2 uv = worldPos.xz * 0.045;
    float n = sin(uv.x * 6.2831 + 1.7) * cos(uv.y * 5.1 - 0.4)
            + sin((uv.x + uv.y) * 3.7) * 0.5;
    n = n * 0.5 + 0.5;
    float size_f = 1.0 - 0.8 * 1.1;
    float puddle = saturate((n - size_f) * rain);
    puddle = smoothstep(0.0, 0.21, puddle);
    return puddle * slope * rain;
}

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    TerrainMaterialData mat = g_TerrainMaterials[input.materialID];

    float2 baseUV = input.texcoord;
    float2 detailUV = input.texcoord * mat.detailScale;

    float4 baseSample = SampleTerrainTexture(mat.baseAlbedoIndex, baseUV);

    float4 mask = SampleTerrainTexture(mat.blendMaskIndex, baseUV);
    float maskSum = dot(mask, float4(1, 1, 1, 1));
    if (maskSum > 0.001)
        mask = mask / maskSum;
    else
        mask = float4(0.25, 0.25, 0.25, 0.25);

    const bool ixrayPbs = (mat.flags & MAT_FLAG_HAS_PBR_LAYER) != 0;

    if (ixrayPbs || (mat.flags & MAT_FLAG_HAS_NORMAL_X) != 0)
    {
        float4 heights = SampleTerrainHeights(mat, detailUV, ixrayPbs);
        mask = HeightBlendMask(heights, mask);
    }

    float3 T = normalize(input.tangent);
    float3 B = normalize(input.bitangent);
    float3 Ngeom = normalize(input.normal);

    float heightAO = 1.0;
    detailUV = TerrainPOM(mat, mask, detailUV, T, B, Ngeom, input.worldPos, ixrayPbs, heightAO);

    float3 detailR = SampleTerrainTexture(mat.detailR_Index, detailUV).rgb;
    float3 detailG = SampleTerrainTexture(mat.detailG_Index, detailUV).rgb;
    float3 detailB = SampleTerrainTexture(mat.detailB_Index, detailUV).rgb;
    float3 detailA = SampleTerrainTexture(mat.detailA_Index, detailUV).rgb;

    float3 blendedDetail =
        detailR * mask.r +
        detailG * mask.g +
        detailB * mask.b +
        detailA * mask.a;

    float3 albedo = baseSample.rgb * blendedDetail * 2.0;

    float3 blendedTS = 0;
    float gloss = 0;

    SampleTerrainBump(mat.normalR_Index, mat.normalXR_Index, detailUV, mask.r, blendedTS, gloss, ixrayPbs);
    SampleTerrainBump(mat.normalG_Index, mat.normalXG_Index, detailUV, mask.g, blendedTS, gloss, ixrayPbs);
    SampleTerrainBump(mat.normalB_Index, mat.normalXB_Index, detailUV, mask.b, blendedTS, gloss, ixrayPbs);
    SampleTerrainBump(mat.normalA_Index, mat.normalXA_Index, detailUV, mask.a, blendedTS, gloss, ixrayPbs);

    if (!ixrayPbs)
        blendedTS.z *= 0.5;

    float3 N = Ngeom;
    if (length(blendedTS) > 1e-4)
    {
        float3x3 TBN = float3x3(T, B, Ngeom);
        float3 ts = ixrayPbs ? normalize(blendedTS) : blendedTS;
        N = normalize(mul(ts, TBN));
    }

    float metallic = 0.0;
    float roughness = 1.0 - gloss;
    float ao = heightAO;
    float sunOcc = 1.0;

    if ((mat.flags & MAT_FLAG_HAS_LMAP) != 0 && mat.lmapIndex != INVALID_TEXTURE_INDEX)
    {
        float2 luv = (dot(input.lmUV, input.lmUV) > 1e-8) ? input.lmUV : baseUV;
        float4 L = GetBindlessTexture(mat.lmapIndex).Sample(smp_linear, luv);
        float lmAo = saturate(dot(L.rgb, float3(0.33, 0.33, 0.33)) * 2.0);
        ao *= lerp(1.0, lmAo, 0.85);
#if defined(CSM_SHADOW_FORWARD)
        sunOcc = 1.0;
#else
        sunOcc = saturate(L.w);
#endif
    }

    if ((mat.flags & MAT_FLAG_HAS_PBR_LAYER) != 0)
    {
        float3 pbrR = SampleTerrainTexture(mat.pbrR_Index, detailUV).rgb;
        float3 pbrG = SampleTerrainTexture(mat.pbrG_Index, detailUV).rgb;
        float3 pbrB = SampleTerrainTexture(mat.pbrB_Index, detailUV).rgb;
        float3 pbrA = SampleTerrainTexture(mat.pbrA_Index, detailUV).rgb;

        float3 blendedPBR =
            pbrR * mask.r +
            pbrG * mask.g +
            pbrB * mask.b +
            pbrA * mask.a;

        metallic = blendedPBR.r;
        roughness = blendedPBR.g;
        ao *= blendedPBR.b;
    }

    // Terrain puddles → gloss/albedo only (wet pass handles cover)
    float rain = fog_color.w;
    float puddle = TerrainPuddle(input.worldPos, N, rain);
    if (puddle > 0.001)
    {
        albedo = lerp(albedo, albedo * float3(0.66, 0.63, 0.60), puddle * 0.25);
        float wetR = ixrayPbs ? max(roughness * 0.65, 0.22) : 0.08;
        roughness = lerp(roughness, wetR, puddle * (ixrayPbs ? 0.4 : 0.7));
    }

    f_forward fwd = output_forward_pbr(
        albedo, N, input.worldPos, metallic, roughness, ao, input.position,
        input.hemi, sunOcc);
    output.color = float4(fwd.color.rgb, 1.0);
    output.normal = fwd.normal;
    output.baseColor = fwd.baseColor;
    output.worldPos = float4(fwd.worldPos.xyz, 4.0);
    return output;
}
