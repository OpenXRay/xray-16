// xrRender/Shaders/forward/sky_forward.ps
// Sky dome — classic CoP path (sky2.ps): tint * cubemap * 0.33,
// then unified tonemap applies scale (classic used scale*2 → net 0.66).

#include "shared/common.h"
#include "common_samplers.h"

struct PS_INPUT {
    float4 hpos     : SV_POSITION;
    float4 color    : COLOR0;      // RGB = sky color tint, A = blend factor
    float3 tc0      : TEXCOORD0;
    float3 tc1      : TEXCOORD1;
    float  elev     : TEXCOORD2;
};

TextureCube s_sky0 : register(t0);
TextureCube s_sky1 : register(t1);

// Horizon fog — matches distance-fogged geometry so the horizon has no hard cut.
// b0/b1/b2 are taken by common.h (dynamic_transforms/shader_params/static_globals).
cbuffer SkyFog : register(b3)
{
    float4 sky_fog_color;
    float4 sky_fog_params; // x=band height, y=strength
};

float4 main(PS_INPUT I) : SV_TARGET
{
    float3 s0 = s_sky0.Sample(smp_rtlinear, I.tc0).rgb;
    float3 s1 = s_sky1.Sample(smp_rtlinear, I.tc1).rgb;

    // Classic: factor.xyz * lerp(s0, s1, factor.w); sky *= 0.33
    // Classic then tonemapped with scale*2 → effective pre-scale 0.66 here.
    float3 sky = I.color.rgb * lerp(s0, s1, I.color.a);
    sky *= 0.66;

    float bandH   = max(sky_fog_params.x, 1e-3);
    float strength = saturate(sky_fog_params.y);
    float fogT = saturate((bandH - I.elev) / bandH) * strength;
    sky = lerp(sky, sky_fog_color.rgb, fogT);

    return float4(sky, 1.0);
}
