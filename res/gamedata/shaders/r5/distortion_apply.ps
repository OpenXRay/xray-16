#define SM_6_0
#include "common.h"
#include "shared/surface_marks.h"

Texture2D g_Snapshot : register(t0);
Texture2D g_Distortion : register(t1);
Texture2D<float4> g_WorldPos : register(t2);
Texture2D<float4> g_BaseColor : register(t3);

struct PS_INPUT
{
    float4 position : SV_POSITION;
    float2 texcoord : TEXCOORD0;
};

bool IsHudNear(float2 uv, float2 texel)
{
    [unroll]
    for (int y = -2; y <= 2; ++y)
    {
        [unroll]
        for (int x = -2; x <= 2; ++x)
        {
            float2 p = uv + float2(x, y) * texel;
            float m = g_WorldPos.SampleLevel(smp_nofilter, saturate(p), 0).w;
            if (IsHudSurfMark(m))
                return true;
        }
    }
    return false;
}

float4 main(PS_INPUT input) : SV_Target0
{
    float4 snapshot = g_Snapshot.Sample(smp_linear, input.texcoord);
    float4 distortSample = g_Distortion.Sample(smp_nofilter, input.texcoord);
    float2 offset = distortSample.xy;
    float totalWeight = distortSample.w;

    if (totalWeight < 0.0001 || dot(offset, offset) < 1e-10)
        return snapshot;

    float mark = g_WorldPos.SampleLevel(smp_nofilter, input.texcoord, 0).w;
    if (IsHudSurfMark(mark) || !IsWaterSurfMark(mark))
        return snapshot;

    float2 texel = screen_res.zw;
    if (IsHudNear(input.texcoord, texel))
        return snapshot;

    float2 displaced = saturate(input.texcoord + offset);
    float destMark = g_WorldPos.SampleLevel(smp_nofilter, displaced, 0).w;
    if (IsHudSurfMark(destMark) || !IsWaterSurfMark(destMark))
        return snapshot;
    if (IsHudNear(displaced, texel))
        return snapshot;

    return g_Snapshot.Sample(smp_linear, displaced);
}
