#define SM_6_0
#include "common.h"
#include "shared/surface_marks.h"

Texture2D g_Snapshot : register(t0);
Texture2D g_Distortion : register(t1);
Texture2D<float4> g_WorldPos : register(t2);
Texture2D<float4> g_BaseColor : register(t3);

struct PS_INPUT
{
    float4 position : SV_POSITION;
    float2 texcoord : TEXCOORD0;
};

float DistBorderAtten(float2 pos, float value)
{
    float borderDist = min(1.0 - max(pos.x, pos.y), min(pos.x, pos.y));
    return saturate(borderDist > value ? 1.0 : borderDist / value);
}

bool IsHudNear(float2 uv, float2 texel)
{
    [unroll]
    for (int y = -2; y <= 2; ++y)
    {
        [unroll]
        for (int x = -2; x <= 2; ++x)
        {
            float2 p = uv + float2(x, y) * texel;
            float m = g_WorldPos.SampleLevel(smp_nofilter, saturate(p), 0).w;
            if (IsHudSurfMark(m))
                return true;
        }
    }
    return false;
}

float4 main(PS_INPUT input) : SV_Target0
{
    float4 snapshot = g_Snapshot.Sample(smp_linear, input.texcoord);
    float4 distortSample = g_Distortion.Sample(smp_nofilter, input.texcoord);
    float totalWeight = distortSample.w;

    if (totalWeight < 0.0001)
        return snapshot;

    float2 offset = distortSample.xy / max(totalWeight, 1e-3);
    float srcViewZ = distortSample.z / max(totalWeight, 1e-3);
    if (dot(offset, offset) < 1e-10)
        return snapshot;

    float4 wp = g_WorldPos.SampleLevel(smp_nofilter, input.texcoord, 0);
    if (IsHudSurfMark(wp.w))
        return snapshot;

    float2 texel = screen_res.zw;
    if (IsHudNear(input.texcoord, texel))
        return snapshot;

    if (wp.w > 0.5)
    {
        float destViewZ = abs(mul(m_V, float4(wp.xyz, 1.0)).z);
        if (srcViewZ > destViewZ + 0.2)
            return snapshot;
    }

    float border = DistBorderAtten(input.texcoord, 0.04);
    float w = saturate(totalWeight);
    offset *= border * w;
    offset = clamp(offset, -0.02, 0.02);

    float2 displaced = input.texcoord + offset;
    if (any(displaced < 0.0) || any(displaced > 1.0))
        return snapshot;

    float destMark = g_WorldPos.SampleLevel(smp_nofilter, displaced, 0).w;
    if (IsHudSurfMark(destMark))
        return snapshot;
    if (IsHudNear(displaced, texel))
        return snapshot;

    float4 warped = g_Snapshot.Sample(smp_linear, displaced);
    float3 snapLum = max(snapshot.rgb, 0.0);
    float3 warpLum = max(warped.rgb, 0.0);
    float snapY = dot(snapLum, float3(0.2126, 0.7152, 0.0722));
    float warpY = dot(warpLum, float3(0.2126, 0.7152, 0.0722));
    float spark = saturate(warpY / max(snapY, 1e-3) - 2.5);
    warped.rgb = lerp(warped.rgb, snapshot.rgb, spark * 0.85);
    return float4(lerp(snapshot.rgb, warped.rgb, saturate(w * 1.25)), snapshot.a);
}
