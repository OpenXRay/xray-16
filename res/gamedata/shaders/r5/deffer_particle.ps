#include "common.h"
#include "sload.h"

struct p_particle
{
	float4 color : COLOR0;
	p_flat base;
};

f_forward main( p_particle II )
{
	p_flat I;
	I = II.base;

	// Base texture with vertex color modulation + alpha test
	float4 D = s_base.Sample(smp_base, I.tcdh);
	D *= II.color;
	clip(D.w - def_aref);

	// Normalized vertex normal (view space)
	float3 Nv = normalize((float3)I.N.xyz);

	// Transform to world space for PBR lighting
	float3 Nw = viewDirToWorld(Nv);

	// Get world position from view position
	float3 worldPos = viewPosToWorld(I.position.xyz);

	// Particles use simple ambient lighting (no specular)
	float3 albedo = D.rgb;
	float hemi = I.position.w;
	float3 ambientColor = L_ambient.rgb + L_hemi_color.rgb * hemi;
	float3 finalColor = albedo * ambientColor;

	f_forward res;
	res.color = float4(finalColor, D.w);
	return res;
}
