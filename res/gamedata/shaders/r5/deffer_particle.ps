#include "common.h"
#include "sload.h"

struct 	p_particle
{
	float4 	color	: COLOR0;
	p_flat	base;
};

f_forward 	main	( p_particle II )
{
  p_flat	I;	I=II.base;

  float4 	D 	= 	s_base.Sample( smp_base, I.tcdh);
		D	*=	II.color;
	clip	(D.w-def_aref);

  float3 Ne = normalize((float3)I.N.xyz);

  float3 albedo = D.rgb;
  float roughness = 1.0 - def_gloss;
  float metallic = 0.0;

  return output_forward_color(albedo, Ne, metallic, roughness);
}
