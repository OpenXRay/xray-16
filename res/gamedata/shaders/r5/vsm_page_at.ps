#define SM_6_0
#include "common.h"
#include "bindless_common.h"
#include "common_dither.h"

struct PS_INPUT
{
    float4 position : SV_Position;
#ifdef TARGET_DXIL
    float4 clip : SV_ClipDistance;
#endif
    float2 texcoord : TEXCOORD0;
    nointerpolation uint materialID : TEXCOORD1;
};

void main(PS_INPUT input)
{
    MaterialData mat = g_Materials[input.materialID];
    if ((mat.flags & (MAT_FLAG_ALPHA_TEST | MAT_FLAG_ALPHA_BLEND)) == 0u)
        return;
    float alpha = (mat.flags & MAT_FLAG_ALPHA_BLEND) != 0u
        ? SampleDiffuseLevel(mat, input.texcoord).a
        : SampleDiffuse(mat, input.texcoord).a;
    if ((mat.flags & MAT_FLAG_ALPHA_TEST) != 0u)
        clip(alpha - mat.alphaRef);
    if ((mat.flags & MAT_FLAG_ALPHA_BLEND) != 0u)
        clip(saturate(alpha) - Bayer4x4Threshold(uint2(input.position.xy)));
}
