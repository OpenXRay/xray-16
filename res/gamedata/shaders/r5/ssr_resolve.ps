// ssr_resolve.ps — reflections on terrain, props, NPC, mutants, grass (SSFX-like)
#define SM_6_0
#define SSR_QUALITY 3
#define SSR_OPAQUE_REFLECTOR
#define SSR_NO_VERTICAL_FADE
#define SSR_NO_EDGE_ATTEN
#define SSR_KEEP_DIM_HITS
#include "common.h"
#include "shared/ssr.h"

Texture2D g_Color    : register(t0);
Texture2D g_Normal   : register(t1);
Texture2D g_Base     : register(t2);
Texture2D g_History  : register(t3);
Texture2D g_WorldPos : register(t40);
Texture2D g_Motion   : register(t22);
TextureCube s_env0   : register(t25);
TextureCube s_env1   : register(t26);

cbuffer SSRParams : register(b5)
{
    float roughnessCutoff;
    float intensity;
    float hasHistory;
    float frameIndex;
    float marchSteps;
    float marchDistance;
    float marchThickness;
    float refineSteps;
    float enableNearMarch;
    float _pad1;
    float _pad2;
    float _pad3;
};

struct PS_INPUT { float4 pos : SV_Position; float2 uv : TEXCOORD0; };

float3 ToneHit(float3 rgb)
{
    float3 c = max(rgb, 0.0);
    return c / (1.0 + c * 1.15);
}

float3 CapRefl(float3 rgb)
{
    float3 c = ToneHit(rgb);
    float lum = dot(c, float3(0.2126, 0.7152, 0.0722));
    return c * rcp(1.0 + max(lum - 0.35, 0.0) * 2.2);
}

float Lum(float3 c)
{
    return dot(max(c, 0.0), float3(0.2126, 0.7152, 0.0722));
}

float4 main(PS_INPUT I) : SV_Target
{
    float keep = g_History.SampleLevel(smp_linear, I.uv, 0).a * 0.0
               + g_Motion.SampleLevel(smp_nofilter, I.uv, 0).x * 0.0
               + g_Color.SampleLevel(smp_linear, I.uv, 0).a * 0.0
               + hasHistory * 0.0 + frameIndex * 0.0;

    float rawDepth = g_SceneDepth.SampleLevel(smp_nofilter, I.uv, 0).x;
    if (rawDepth >= 0.9995)
        return float4(0, 0, 0, 0);

    float2 ndc = float2(I.uv.x * 2.0 - 1.0, 1.0 - I.uv.y * 2.0);
    float4 worldH = mul(m_InvVP, float4(ndc, rawDepth, 1.0));
    float3 reconPos = worldH.xyz / max(worldH.w, 1e-5);
    float4 wpSamp = g_WorldPos.SampleLevel(smp_nofilter, I.uv, 0);
    float isHud = (wpSamp.w > 1.5 && wpSamp.w < 2.5) ? 1.0 : 0.0;
    float3 worldPos = (wpSamp.w > 1.5 || length(wpSamp.xyz) > 0.05) ? wpSamp.xyz : reconPos;
    float viewZ = abs(mul(m_V, float4(worldPos, 1.0)).z);

    float4 nSample = g_Normal.SampleLevel(smp_nofilter, I.uv, 0);
    float3 N = normalize(nSample.xyz + 1e-5);
    float roughness = saturate(nSample.w);
    float gloss = saturate(1.0 - roughness);
    float up = saturate(N.y);
    float side = saturate(1.0 - abs(N.y));

    float4 base = g_Base.SampleLevel(smp_linear, I.uv, 0);
    float metallic = UnpackMetallicFromBaseA(base.a);
    if (wpSamp.w > 2.5 && wpSamp.w < 3.5)
        metallic = 0.0;
    float floraHint = saturate(base.g - max(base.r, base.b)) * saturate(1.0 - abs(roughness - 0.45) * 2.2);
    float floraScale = lerp(1.0, 0.72, floraHint);

    float rain = saturate(fog_color.w);
    float wetBoost = wpSamp.w > 1.5 ? 1.0 : 0.0;
    float charWet = (wpSamp.w > 2.5 && wpSamp.w < 3.5) ? 1.0 : 0.0;
    float terrainWet = (wpSamp.w > 3.5 && wpSamp.w < 4.5) ? 1.0 : 0.0;
    float cut = max(roughnessCutoff, 0.72);
    float matGloss = saturate(smoothstep(cut, cut * 0.35, roughness));
    float wetWritten = saturate((0.42 - roughness) * 4.5);
    float wetness = saturate((0.78 - roughness) * 2.4);
    wetness = max(wetness, wetWritten * rain * saturate(0.3 + up * 0.5 + side * 0.25) * lerp(0.75, 1.15, wetBoost));
    wetness = max(wetness, wetWritten * wetBoost * rain * (0.4 + gloss * 0.35));
    wetness = max(wetness, wetWritten * terrainWet * rain * (0.5 + up * 0.3 + gloss * 0.25));
    float charFloor = 0.34 * rain * wetWritten;
    float charAdd = 0.14 * rain * wetWritten;
    wetness = lerp(wetness, saturate(max(wetness, charFloor) + charAdd), charWet * wetWritten);
    wetness = lerp(wetness, lerp(wetness, 0.48, 0.4), charWet * rain * wetWritten);
    float metalBoost = lerp(1.0, 1.85, metallic * gloss);
    float matteKill = saturate((roughness - 0.82) * 8.0);
    float surf = saturate(matGloss * 0.95 + wetness * lerp(1.35, lerp(1.85, 2.05, terrainWet), wetBoost) * wetWritten + metallic * (0.45 + gloss * 0.7));
    surf = max(surf, rain * wetness * wetWritten * lerp(0.45, 0.75, wetBoost));
    surf *= saturate(0.55 + up * 0.35 + side * 0.45);
    surf = max(surf, wetWritten * wetBoost * rain * (0.25 + gloss * 0.4));
    surf = max(surf, wetWritten * terrainWet * rain * up * (0.3 + gloss * 0.35));
    surf = lerp(surf, saturate(max(surf, charFloor) + charAdd), charWet * wetWritten);
    surf *= floraScale * metalBoost;
    surf *= lerp(1.0, 0.08, matteKill * (1.0 - metallic) * (1.0 - charWet * wetWritten));
    surf = max(surf, metallic * saturate(0.35 + gloss * 0.55));

    if (surf < 0.03)
        return float4(0, 0, 0, 0);

    float3 V = normalize(worldPos - eye_position);
    float3 R = reflect(V, N);
    if (isHud < 0.5 && up > 0.55)
        R.y = max(R.y, 0.03);
    R = normalize(R);

    float mipCount = 8.0;
    float cubeLod = saturate(roughness) * max(mipCount - 1.0, 0.0);
    float3 cube = CapRefl(lerp(
        s_env0.SampleLevel(smp_rtlinear, R, cubeLod).rgb,
        s_env1.SampleLevel(smp_rtlinear, R, cubeLod).rgb, saturate(L_ambient.w))) * 0.1;
    float3 amb = CapRefl(L_ambient.rgb * 0.1 + L_hemi_color.rgb * 0.05);
    float3 fill = lerp(amb, cube, 0.25) * 0.35;
    fill *= lerp(0.6, 0.35, metallic * gloss);

    int steps = clamp((int)marchSteps, 16, 48);
    float nearField = saturate(1.0 - (viewZ - 0.25) / 3.2);
    float4 ssr = compute_ssr_ex(
        worldPos, N, fill,
        steps, max(marchDistance, 72.0), max(marchThickness, 0.7),
        clamp((int)refineSteps, 2, 6), saturate(roughness) * 0.45);
    if (enableNearMarch > 0.5 && nearField > 0.35)
    {
        float4 ssrN = compute_ssr_near(
            worldPos, N, fill,
            max(steps, 32), lerp(42.0, 20.0, nearField), lerp(0.8, 0.4, nearField),
            clamp((int)refineSteps, 2, 6), saturate(roughness) * 0.28);
        float nw = saturate(nearField) * saturate(ssrN.a * 2.2);
        ssr = float4(lerp(ssr.rgb, ssrN.rgb, nw * 0.65), max(ssr.a, ssrN.a * nearField * 0.75));
    }

    float conf = saturate(ssr.a);
    float3 hitCol = ToneHit(ssr.rgb);
    float hitLum = Lum(hitCol);
    float fillLum = max(Lum(fill), 1e-4);
    float hitChroma = length(hitCol - hitLum.xxx);
    float skyAmt = saturate((hitLum - 0.28) * 2.4) * saturate(1.15 - hitChroma * 8.0);
    skyAmt *= saturate(1.15 - conf * 1.0);
    hitCol *= lerp(1.0, 0.22, skyAmt);
    conf *= lerp(1.0, 0.35, skyAmt);
    float spark = saturate(hitLum / fillLum - 3.2) * saturate(1.2 - conf);
    hitCol *= lerp(1.0, 0.35, spark);
    conf *= lerp(1.0, 0.4, spark);
    conf = saturate(conf * 1.15);
    float3 refl = lerp(fill * 0.08, hitCol, saturate(conf));

    float NdV = saturate(dot(-V, N));
    float fresnelGrazing = pow(saturate(1.0 - NdV), 3.2);
    float faceWet = wetness * wetWritten * saturate(0.45 + side * 0.5 + up * 0.25);
    float fresnel = max(fresnelGrazing, faceWet * lerp(0.5, lerp(0.75, 0.85, terrainWet), wetBoost));
    fresnel = max(fresnel, metallic * (0.4 + gloss * 0.5));
    fresnel = max(fresnel, gloss * gloss * lerp(0.2, 0.36, wetBoost));
    fresnel = max(fresnel, rain * wetness * wetWritten * lerp(0.18, lerp(0.42, 0.52, terrainWet), wetBoost) * (1.0 + gloss * 0.35));
    fresnel = lerp(fresnel, saturate(max(fresnel, 0.28 * rain * wetWritten) + 0.12 * rain * wetWritten), charWet);
    float hitGate = saturate(smoothstep(0.04, 0.5, conf) + metallic * gloss * 0.12 + wetBoost * wetWritten * 0.2 + 0.16);
    float w = saturate(surf * fresnel * max(intensity, 1.0) * lerp(0.52, lerp(0.84, 0.96, terrainWet), wetBoost) * hitGate) + keep;
    float wMax = lerp(0.2, 0.3, saturate(viewZ * 0.1));
    wMax = lerp(wMax, max(wMax, 0.33), rain * wetness * wetWritten);
    wMax = max(wMax, wetBoost * rain * wetWritten * (0.38 + conf * 0.26));
    wMax = max(wMax, terrainWet * rain * wetWritten * up * (0.42 + conf * 0.28));
    wMax = max(wMax, metallic * gloss * (0.36 + conf * 0.18));
    wMax = max(wMax, gloss * gloss * lerp(0.28, 0.44, wetBoost));
    wMax = max(wMax, nearField * (0.24 + conf * 0.22));
    wMax = max(wMax, charWet * rain * wetWritten * (0.42 + conf * 0.26));
    w = lerp(w, saturate(max(w, 0.18 * rain * wetWritten) + 0.1 * rain * wetWritten), charWet);
    w *= lerp(1.0, 0.32, skyAmt);
    w *= lerp(1.0, 0.6, spark);
    w = min(w, wMax);

    return float4(refl, saturate(w));
}
