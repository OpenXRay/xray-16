// ssr_resolve.ps — reflections on terrain, props, NPC, mutants, grass (SSFX-like)
#define SM_6_0
#define SSR_QUALITY 3
#define SSR_OPAQUE_REFLECTOR
#define SSR_NO_VERTICAL_FADE
#define SSR_NO_EDGE_ATTEN
#define SSR_ACCEPT_SKY
#define SSR_KEEP_DIM_HITS
#include "common.h"
#include "shared/ssr.h"

Texture2D g_Color   : register(t0);
Texture2D g_Normal  : register(t1);
Texture2D g_Base    : register(t2);
Texture2D g_History : register(t3);
Texture2D g_Motion  : register(t22);
TextureCube s_env0  : register(t25);
TextureCube s_env1  : register(t26);

cbuffer SSRParams : register(b5)
{
    float roughnessCutoff;
    float intensity;
    float hasHistory;
    float frameIndex;
    float marchSteps;
    float marchDistance;
    float marchThickness;
    float refineSteps;
    float _pad0;
    float _pad1;
    float _pad2;
    float _pad3;
};

struct PS_INPUT { float4 pos : SV_Position; float2 uv : TEXCOORD0; };

float3 ToneHit(float3 rgb)
{
    float3 c = max(rgb, 0.0);
    return c / (1.0 + c * 1.6);
}

// Keep reflections from blowing out the plate (sky / overbright scene)
float3 CapRefl(float3 rgb)
{
    float3 c = ToneHit(rgb);
    float lum = dot(c, float3(0.2126, 0.7152, 0.0722));
    return c * rcp(1.0 + max(lum - 0.22, 0.0) * 3.5);
}

float4 main(PS_INPUT I) : SV_Target
{
    float keep = g_Motion.SampleLevel(smp_nofilter, I.uv, 0).x * 0.0
               + g_Color.SampleLevel(smp_linear, I.uv, 0).a * 0.0
               + g_History.SampleLevel(smp_linear, I.uv, 0).a * 0.0
               + (hasHistory + frameIndex) * 0.0;

    float rawDepth = g_SceneDepth.SampleLevel(smp_nofilter, I.uv, 0).x;
    if (rawDepth >= 0.9995)
        return float4(0, 0, 0, 0);

    float2 ndc = float2(I.uv.x * 2.0 - 1.0, 1.0 - I.uv.y * 2.0);
    float4 worldH = mul(m_InvVP, float4(ndc, rawDepth, 1.0));
    float3 worldPos = worldH.xyz / max(worldH.w, 1e-5);
    float viewZ = abs(mul(m_V, float4(worldPos, 1.0)).z);

    float4 nSample = g_Normal.SampleLevel(smp_nofilter, I.uv, 0);
    float3 N = normalize(nSample.xyz + 1e-5);
    float roughness = saturate(nSample.w);
    float gloss = saturate(1.0 - roughness);
    float up = saturate(N.y);
    float side = saturate(1.0 - abs(N.y));

    // Base color cue: dark wet grass/rock often in g_Base; keep binding live
    float4 base = g_Base.SampleLevel(smp_linear, I.uv, 0);
    float baseLum = dot(base.rgb, float3(0.2126, 0.7152, 0.0722));
    // Flora: keep wet SSR readable (was 0.33 — grass looked dry)
    float floraHint = saturate(base.g - max(base.r, base.b)) * saturate(1.0 - abs(roughness - 0.45) * 2.2);
    float floraScale = lerp(1.0, 0.72, floraHint);

    // Material gloss + rain-wetness (grass/NPC after wet write ~0.18–0.30 rough)
    float cut = max(roughnessCutoff, 0.72);
    float matGloss = saturate(smoothstep(cut, cut * 0.35, roughness));
    float wetness = saturate((0.72 - roughness) * 2.0);
    float surf = saturate(matGloss * 0.85 + wetness * 1.15);
    surf *= saturate(0.6 + up * 0.4 + side * 0.4);
    surf *= floraScale;

    if (surf < 0.03)
        return float4(0, 0, 0, 0);

    float3 V = normalize(worldPos - eye_position);
    float3 R = reflect(V, N);
    // Only bias floor rays upward; characters/rocks may reflect downward into ground
    if (up > 0.55)
        R.y = max(R.y, 0.03);
    R = normalize(R);

    float cubeLod = 2.0 + roughness * 5.0;
    // Dim cubemap heavily — rain sky was washing the whole frame
    float3 cube = CapRefl(lerp(
        s_env0.SampleLevel(smp_rtlinear, R, cubeLod).rgb,
        s_env1.SampleLevel(smp_rtlinear, R, cubeLod).rgb, 0.5)) * 0.38;
    float3 amb = CapRefl(L_ambient.rgb * 0.35 + L_hemi_color.rgb * 0.15);
    float3 fill = lerp(amb, cube, 0.45);

    int steps = clamp((int)marchSteps, 16, 48);
    float4 ssr = compute_ssr_ex(
        worldPos, N, fill,
        steps, max(marchDistance, 72.0), max(marchThickness, 0.7),
        clamp((int)refineSteps, 2, 6), saturate(roughness) * 0.55);
    float conf = saturate(ssr.a);
    // Misses stay on dim fill (no bright sky plate); hits use scene color
    float3 hitCol = CapRefl(ssr.rgb);
    float3 refl = lerp(fill, hitCol, conf);

    float NdV = saturate(dot(-V, N));
    float fresnelGrazing = pow(saturate(1.0 - NdV), 3.0);
    // Wet cloth/leather: keep face-on sheen so NPC fronts actually gleam
    float faceWet = wetness * saturate(0.4 + side * 0.45 + up * 0.2);
    float fresnel = max(fresnelGrazing, faceWet * 0.48);
    float w = saturate(surf * fresnel * max(intensity, 0.55) * 0.42) + keep;
    // Cap blend — floors readable, no sky blowout
    float wpn = smoothstep(0.25, 1.8, viewZ);
    float wMax = lerp(0.12, 0.16, wpn);
    w = min(w, wMax);

    return float4(refl, w);
}
