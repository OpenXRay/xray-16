#define SM_6_0
Texture2D g_Bloom : register(t0);
Texture2D<float> g_Depth : register(t1);
SamplerState smp_rtlinear : register(s0);

cbuffer BloomParams : register(b0)
{
    float intensity;
    float skyDepth;
    float2 _pad;
};

struct PS_INPUT { float4 pos : SV_Position; float2 uv : TEXCOORD0; };

float4 main(PS_INPUT I) : SV_Target
{
    float2 uv = saturate(I.uv);
    float3 bloom = max(g_Bloom.SampleLevel(smp_rtlinear, uv, 0).rgb, 0.0);

    uint dw = 0, dh = 0, cw = 0, ch = 0;
    g_Depth.GetDimensions(dw, dh);
    g_Bloom.GetDimensions(cw, ch);

    float skyMask = 1.0;
    if (dw == cw && dh == ch && dw > 0)
    {
        float depth = g_Depth.Load(int3(int2(uv * float2(dw, dh)), 0));
        skyMask = depth >= skyDepth ? 0.0 : 1.0;
    }

    return float4(bloom * intensity * skyMask, 1.0);
}
