// bloom/composite.ps — bloom contribution only (scene is copied, then this is added)
#define SM_6_0
Texture2D g_Bloom : register(t0);
SamplerState smp_rtlinear : register(s0);

cbuffer BloomParams : register(b0)
{
    float intensity;
    float3 _pad;
};

struct PS_INPUT { float4 pos : SV_Position; float2 uv : TEXCOORD0; };

float4 main(PS_INPUT I) : SV_Target
{
    float2 uv = saturate(I.uv);
    float3 bloom = g_Bloom.SampleLevel(smp_rtlinear, uv, 0).rgb;
    // Soft knee so huge HDR sun doesn't blow the whole frame
    bloom = bloom / (1.0 + bloom);
    return float4(bloom * intensity, 1.0);
}
