// ssgi_blur.ps — bilateral blur for SSGI
#define SM_6_0
#include "common.h"

Texture2D g_SSGI  : register(t0);
Texture2D g_Depth : register(t1);

cbuffer SSGIBlurParams : register(b5)
{
    float2 texelSize;
    float2 _pad;
};

struct PS_INPUT { float4 pos : SV_Position; float2 uv : TEXCOORD0; };

float4 main(PS_INPUT I) : SV_Target
{
    float centerZ = g_Depth.SampleLevel(smp_nofilter, I.uv, 0).x;
    if (centerZ >= 0.9995)
        return float4(0, 0, 0, 0);

    float4 center = g_SSGI.SampleLevel(smp_nofilter, I.uv, 0);
    float3 sum = center.rgb;
    float wsum = 1.0;

    [unroll]
    for (int i = -2; i <= 2; ++i)
    {
        [unroll]
        for (int j = -2; j <= 2; ++j)
        {
            if (i == 0 && j == 0)
                continue;
            float2 uv = I.uv + float2(i, j) * texelSize;
            float4 s = g_SSGI.SampleLevel(smp_nofilter, uv, 0);
            float z = g_Depth.SampleLevel(smp_nofilter, uv, 0).x;
            float wz = exp(-abs(z - centerZ) * 80.0);
            float ws = exp(-0.5 * float(i * i + j * j));
            float w = wz * ws;
            sum += s.rgb * w;
            wsum += w;
        }
    }

    return float4(sum / max(wsum, 1e-4), center.a);
}
