#define SM_6_0
#include "common.h"
#include "bindless_common.h"
#include "shared/wmark.h"

#define DECAL_FLAG_STATIC   0u
#define DECAL_FLAG_SKELETON 1u
#define DECAL_FLAG_MULTIPLY 2u

struct GPUDecalData
{
    float4x4 worldToDecal;
    float4x4 decalToWorld;
    uint materialID;
    float opacity;
    float normalThreshold;
    uint flags;
};

cbuffer DecalDrawCB : register(b4)
{
    uint g_WantMultiply;
    uint3 _decalDrawPad;
};

StructuredBuffer<GPUDecalData> g_Decals : register(t3);
Texture2D<float> g_Depth : register(t24);
Texture2D<float4> g_WorldPos : register(t25);

struct VS_OUTPUT
{
    float4 position : SV_Position;
    float4 screenPos : TEXCOORD0;
    nointerpolation uint instanceID : TEXCOORD1;
};

float4 main(VS_OUTPUT input) : SV_Target0
{
    GPUDecalData decal = g_Decals[input.instanceID];
    bool multiply = (decal.flags & DECAL_FLAG_MULTIPLY) != 0u;
    if (multiply != (g_WantMultiply != 0u))
        discard;

    int2 pixelCoord = int2(input.position.xy);

    float depth = g_Depth.Load(int3(pixelCoord, 0));
    if (IsSkyDepth(depth))
        discard;

    float4 worldPosData = g_WorldPos.Load(int3(pixelCoord, 0));
    float geoType = worldPosData.w;
    bool isStatic = geoType < 1.5 || (geoType > 3.5 && geoType < 4.5);
    bool isSkeleton = geoType > 2.5 && geoType < 3.5;
    if ((decal.flags & 1u) == 0u && !isStatic)
        discard;
    if ((decal.flags & 1u) != 0u && !isSkeleton)
        discard;
    if ((decal.flags & 1u) != 0u && depth > 0.9)
        discard;

    float3 worldPos = reconstruct_world_pos(input.position.xy, depth);
    float3 decalN = normalize(mul((float3x3)decal.decalToWorld, float3(0, 1, 0)));
    worldPos += decalN * NORMAL_SHIFT;

    float4 decalLocal = mul(decal.worldToDecal, float4(worldPos, 1.0));
    float3 absLocal = abs(decalLocal.xyz);
    if (absLocal.x > 0.5 || absLocal.y > 0.5 || absLocal.z > 0.5)
        discard;

    float2 uv = decalLocal.xz + 0.5;

    MaterialData mat = g_Materials[decal.materialID];
    float4 decalColor = SampleDiffuse(mat, uv);
    float metallic, roughness, ao, parallax;
    ResolveMaterialPBR(mat, uv, 0.0, metallic, roughness, ao, parallax);
    decalColor.rgb *= ao;

    float3 edgeDist = 0.5 - absLocal;
    float minEdge = min(edgeDist.x, min(edgeDist.y, edgeDist.z));
    float edgeFade = saturate(minEdge * 8.0);
    float a = saturate(decalColor.a * decal.opacity * edgeFade);
    if (a < 0.01)
        discard;

    if (multiply)
    {
        float3 rgb = lerp(float3(0.5, 0.5, 0.5), decalColor.rgb, a);
        return float4(rgb, 1.0);
    }

    return float4(decalColor.rgb, a);
}
