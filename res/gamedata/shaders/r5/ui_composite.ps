Texture2D sceneTexture : register(t0);
Texture2D uiTexture    : register(t1);

#include "common_samplers.h"

struct PS_INPUT
{
    float4 position : SV_POSITION;
    float2 texcoord : TEXCOORD0;
};

float4 main(PS_INPUT input) : SV_TARGET
{
    float4 sceneColor = sceneTexture.Sample(smp_linear, input.texcoord);
    float4 uiColor = uiTexture.Sample(smp_linear, input.texcoord);

    float3 blended = lerp(sceneColor.rgb, uiColor.rgb, uiColor.a);

    return float4(blended, sceneColor.a);
}

