#define SM_6_0
#include "common.h"
#include "bindless_common.h"
#include "skinned_common.h"

struct PS_INPUT
{
    float4 position : SV_Position;
    float3 worldPos : TEXCOORD0;
    float2 texcoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 bitangent : TEXCOORD4;
    nointerpolation uint materialID : TEXCOORD5;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
};

float3 UndoHUDFOVDirection(float3 adjustedDir)
{
    float3x3 rot = float3x3(m_V[0].xyz, m_V[1].xyz, m_V[2].xyz);
    float3 viewDir = mul(rot, adjustedDir);
    viewDir.xy *= hud_fov;
    return normalize(mul(transpose(rot), viewDir));
}

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    uint materialID = g_SkinnedMaterialID;
    MaterialData mat = g_Materials[materialID];

    float4 diffuseSample = SampleDiffuse(mat, input.texcoord);

    if (mat.flags & MAT_FLAG_ALPHA_TEST)
    {
        clip(diffuseSample.a - mat.alphaRef);
    }

    float3 albedo = diffuseSample.rgb;

    float3 N = UndoHUDFOVDirection(input.normal);
    float gloss = 0.0;
    if (mat.flags & MAT_FLAG_HAS_NORMAL)
    {
        BumpSample bump = SampleNormal(mat, input.texcoord);
        float3x3 TBN = float3x3(
            UndoHUDFOVDirection(input.tangent),
            UndoHUDFOVDirection(input.bitangent),
            N
        );
        N = normalize(mul(bump.normal, TBN));
        gloss = bump.gloss;
    }

    if (mat.flags & MAT_FLAG_HAS_DETAIL)
    {
        float4 detailSample = SampleDetail(mat, input.texcoord);
        albedo = albedo * (detailSample.rgb * 2.0);
    }

    float metallic = 0.0;
    float roughness = 1.0 - gloss;
    float ao = 1.0;

    if (mat.flags & MAT_FLAG_HAS_PBR)
    {
        float3 pbrSample = SamplePBR(mat, input.texcoord);
        metallic = pbrSample.r;
        roughness = pbrSample.g;
        ao = pbrSample.b;
    }

    albedo = apply_splat_color(albedo, input.worldPos, input.texcoord);

    f_forward fwd = output_gbuffer(albedo, N, metallic, roughness, ao);
    output.color = fwd.color;
    output.normal = fwd.normal;
    output.baseColor = fwd.baseColor;
    output.normal.a = -max(fwd.normal.a, 0.004);
    return output;
}
