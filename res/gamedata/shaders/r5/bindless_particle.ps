#define SM_6_0
#include "common.h"
#include "bindless_common.h"
#include "shared/surface_marks.h"

Texture2D<float4> g_SceneWorldPos : register(t1);

#define DEPTH_EPSILON 0.1

struct PS_INPUT
{
    float4 hpos     : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color    : TEXCOORD1;
    float3 worldPos : TEXCOORD2;
    float3 normal   : TEXCOORD3;
    nointerpolation uint materialID : TEXCOORD4;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    MaterialData mat = g_Materials[input.materialID];
    float4 diffuseSample = SampleDiffuse(mat, input.texcoord);
    float4 result = diffuseSample * input.color;

    clip(result.a - mat.alphaRef);

    if (camera_direction.w > 0.5 && !(mat.flags & MAT_FLAG_PARTICLE_HARD))
    {
        float4 sceneWP = g_SceneWorldPos.Load(int3((int2)input.hpos.xy, 0));
        if (IsHudSurfMark(sceneWP.w))
            discard;
        if (sceneWP.w > 0.5)
        {
            float3 viewDir = camera_direction.xyz;
            float sceneViewZ = dot(sceneWP.xyz - eye_position, viewDir);
            float particleViewZ = dot(input.worldPos - eye_position, viewDir);
            float spaceDepth = sceneViewZ - particleViewZ - DEPTH_EPSILON;
            if (spaceDepth < -2 * DEPTH_EPSILON)
                spaceDepth = 100000.0;
            float soft = Contrast(saturate(spaceDepth * 1.3), 2);
            result.a *= soft;
            result.rgb *= soft;
        }
    }

    // tessMethod: 0=standard, 1=s-blend, 2=s-add, 3=s-aadd (GL particle_s-* color math)
    if (mat.tessMethod == 1)
    {
        float3 r = lerp(float3(1, 1, 1), result.rgb, result.a);
        result = float4(r, 1.0);
    }
    else if (mat.tessMethod == 2)
    {
        float3 r = float3(1, 1, 1) - result.rgb - result.rgb * result.rgb;
        result = float4(r, 1.0);
    }
    else if (mat.tessMethod == 3)
    {
        float3 c = result.rgb * result.a;
        float3 r = float3(1, 1, 1) - c + c * c;
        result = float4(r, 1.0);
    }

    output.color = result;
    output.normal = float4(normalize(input.normal), 1);
    output.baseColor = float4(diffuseSample.rgb, 0);
    output.worldPos = float4(input.worldPos, 1.0);
    return output;
}
