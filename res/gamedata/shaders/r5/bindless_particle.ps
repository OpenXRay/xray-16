#define SM_6_0
#include "common.h"
#include "bindless_common.h"

Texture2D<float> g_SceneDepth : register(t1);

#define DEPTH_EPSILON 0.1

struct PS_INPUT
{
    float4 hpos     : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color    : TEXCOORD1;
    float3 worldPos : TEXCOORD2;
    float3 normal   : TEXCOORD3;
    nointerpolation uint materialID : TEXCOORD4;
};

float4 main(PS_INPUT input) : SV_Target
{
    MaterialData mat = g_Materials[input.materialID];
    float4 diffuseSample = float4(1, 0, 1, 1);
    if (mat.diffuseIndex != INVALID_TEXTURE_INDEX)
        diffuseSample = GetBindlessTexture(mat.diffuseIndex).Sample(smp_rtlinear, input.texcoord);
    float4 result = diffuseSample * input.color;
    clip(result.a - (0.01 / 255.0));

    float soft = 1.0;
    const bool softEnabled = camera_direction.w > 0.5;
    const bool isHudBand = input.hpos.z >= 0.85;
    if (softEnabled && !isHudBand)
    {
        float sceneDepth = g_SceneDepth.Load(int3((int2)input.hpos.xy, 0));
        if (sceneDepth > 1e-6)
        {
            float3 sceneWP = reconstruct_world_pos(input.hpos.xy, sceneDepth);
            float3 viewDir = normalize(camera_direction.xyz);
            float sceneViewZ = abs(dot(sceneWP - eye_position, viewDir));
            float particleViewZ = abs(dot(input.worldPos - eye_position, viewDir));
            float spaceDepth = sceneViewZ - particleViewZ - DEPTH_EPSILON;
            if (spaceDepth < -2.0 * DEPTH_EPSILON)
                soft = 1.0;
            else
                soft = smoothstep(0.0, 1.25, max(spaceDepth, 0.0));
        }
    }

    result.a *= soft;
    result.rgb *= soft;
    return result;
}
