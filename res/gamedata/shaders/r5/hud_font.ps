#include "common.h"

struct 	v2p
{
 	half2 	tc0: 	TEXCOORD0;	
 	half4	c0:		COLOR0;
};

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main ( p_TL I ) : SV_Target
{
	float glyph_alpha = s_base.Sample( smp_base, I.Tex0 ).r;
	float3 rgb = I.Color.rgb;
	if (_pad_eye < 0.999)
		rgb = SRGBToLinear(rgb);
	return float4(rgb * max(_pad_eye, 1e-4), glyph_alpha * I.Color.a);
}