#define SM_6_0
#define CLUSTERED_LIGHTING_FORWARD
#include "common.h"
#include "bindless_common.h"
#include "shared/surface_marks.h"
#include "shared/basecolor_pack.h"

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

cbuffer DetailGlobals : register(b3)
{
    float4 consts;
    float4 wave;
    float4 dir2D;
    float4 dir2D_2;
    float4x4 g_detail_VP;
    float4 detail_params;
    float4 g_wind_direction;
    float grass_wind_displacement;
    float grass_interaction_displacement;
    uint interaction_atlas_index;
    uint perlin4d_texture_index;
    float4 grass_color_tip;
    float4 grass_color_base;
    float4 grass_sss_color;
    float grass_color_variation;
    float grass_blade_height;
    uint build_details_index;
    uint build_details_pbr_index;
};

struct GrassObjectTint
{
    float r, g, b, pad;
};
StructuredBuffer<GrassObjectTint> grass_object_tints : register(t34);

static const float GRASS_ROUGHNESS_BASE = 0.85;
static const float GRASS_ROUGHNESS_TIP = 0.55;
static const float GRASS_METALLIC = 0.0;
static const float GRASS_AO_BASE = 0.35;
static const float GRASS_AO_TIP = 1.0;
static const float GRASS_AO_POWER = 0.6;

uniform int dm_debug_trails;

float SampleGrassInteraction(float2 atlas_uv)
{
    Texture2D interaction_tex = GetBindlessTexture(interaction_atlas_index);
    float4 interaction = interaction_tex.Sample(smp_linear, atlas_uv);
    return interaction.r;
}

float ComputeGrassRoughness(float heightParam, float veinDetail)
{
    float baseRoughness = lerp(GRASS_ROUGHNESS_BASE, GRASS_ROUGHNESS_TIP, heightParam);
    float microRoughness = veinDetail * 0.1;
    return saturate(baseRoughness + microRoughness);
}

float ComputeGrassAO(float heightParam, float veinDetail, float widthPercent)
{
    float heightAO = lerp(GRASS_AO_BASE, GRASS_AO_TIP, pow(saturate(heightParam), GRASS_AO_POWER));
    float edgeFactor = abs(widthPercent - 0.5) * 2.0;
    float edgeAO = lerp(0.95, 1.0, edgeFactor);
    float microAO = lerp(0.9, 1.0, veinDetail);
    return heightAO * edgeAO * microAO;
}

PS_OUTPUT main(p_flat I)
{
    float widthPercent = I.tcdh.x;
    float3 N = lerp(I.rotatedNormal1, I.rotatedNormal2, widthPercent);
    N = normalize(N);

    float t = I.heightParam;

    float4 vein_detail = float4(1.0, 1.0, 1.0, 0.0);
    float veinValue = 0.0;

    float3 tipColor = grass_color_tip.rgb;
    float3 baseColor = grass_color_base.rgb;
    float color_blend = smoothstep(0.2, 0.8, t);
    float3 grassAlbedo = lerp(baseColor, tipColor, color_blend);

    float variationAmount = grass_color_variation;
    grassAlbedo *= lerp(1.0 - variationAmount, 1.0 + variationAmount, I.bladeHash);

    GrassObjectTint objectTint = grass_object_tints[I.objectId];
    float3 tintColor = float3(objectTint.r, objectTint.g, objectTint.b);
    grassAlbedo *= tintColor;

    grassAlbedo = lerp(grassAlbedo, grassAlbedo * vein_detail.rgb, veinValue * 0.15);

    float roughness = ComputeGrassRoughness(t, veinValue);
    float metallic = GRASS_METALLIC;
    float ao = ComputeGrassAO(t, veinValue, widthPercent);

    if (dm_debug_trails > 0)
    {
        float interaction_strength = SampleGrassInteraction(I.interaction_uv);
        grassAlbedo = lerp(grassAlbedo, float3(1.0, 0.0, 0.0), interaction_strength * 0.7);
    }

    float viewDist = length(I.position.xyz - eye_position);
    float distFade = exp(-viewDist * 0.017);
    float3 midColor = (grass_color_base.rgb + grass_color_tip.rgb) * 0.5;
    grassAlbedo = lerp(midColor, grassAlbedo, distFade);

    float hemi = saturate(I.position.w);
    float sunOcc = (I.sunOcclusion > 0.01) ? 1.0 : 0.05;
    const bool restir = parallax.w < -0.5;
    float fwdSun = restir ? sunOcc : ((I.sunOcclusion > 0.01) ? consts.z : 0.0);

    f_forward fwd = output_forward_pbr(
        grassAlbedo, N, I.position.xyz, metallic, roughness, ao, I.hpos,
        hemi, fwdSun, false, false);
    PS_OUTPUT o;
    o.color = float4(fwd.color.rgb, sunOcc);
    o.normal = fwd.normal;
    o.baseColor = float4(fwd.baseColor.rgb, PackBaseColorA(metallic, lerp(0.4, 0.9, saturate(t))));
    o.worldPos = float4(I.position.xyz, SURF_MARK_GRASS);
    return o;
}
