#include "common.h"
#include "sload.h"

#define	USE_4_DETAIL

#if defined(USE_TDETAIL) && defined(USE_4_DETAIL)
#	define	USE_4_BUMP
#endif

#ifdef USE_4_BUMP
f_forward 	main	( p_bumped I 	)
#else
f_forward 	main	( p_flat I 		)
#endif
{
 	// Diffuse albedo
	float4 D		= tbase		(I.tcdh);			// IN:  rgb.a
	float4 L 	= s_lmap.Sample( smp_base, I.tcdh);

	float	G	= def_gloss	;

# ifdef	USE_TDETAIL
 # ifdef USE_4_DETAIL
	// 4-layer detail texture blending
	float4	mask= s_mask.Sample ( smp_base, I.tcdh);
	float 	mag	= dot 		(mask,1);
			mask= mask/mag	;

	float3	d_R	= s_dt_r.Sample ( smp_base, I.tcdbump).rgb*mask.r;
	float3	d_G	= s_dt_g.Sample ( smp_base, I.tcdbump).rgb*mask.g;
	float3	d_B	= s_dt_b.Sample ( smp_base, I.tcdbump).rgb*mask.b;
	float3	d_A	= s_dt_a.Sample ( smp_base, I.tcdbump).rgb*mask.a;
	float3	dt	= d_R+d_G+d_B+d_A;
		D.rgb	= 2*D.rgb*dt	 ;

  # ifdef USE_4_BUMP
 	 float4	n_Rt = s_dn_r.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_Gt = s_dn_g.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_Bt = s_dn_b.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_At = s_dn_a.Sample ( smp_linear, I.tcdbump).wzyx;

 	 float3	n_R = (n_Rt.xyz-0.5)*mask.r; float g_R=n_Rt.w*mask.r;
	 float3	n_G = (n_Gt.xyz-0.5)*mask.g; float g_G=n_Gt.w*mask.g;
	 float3	n_B = (n_Bt.xyz-0.5)*mask.b; float g_B=n_Bt.w*mask.b;
	 float3	n_A = (n_At.xyz-0.5)*mask.a; float g_A=n_At.w*mask.a;

	 float3	mix		= 	n_R+n_G+n_B+n_A;
			mix.z	*=	0.5;		//. make bump twice as contrast (fake, remove me if possible)
	 float3	N		= 	mul     	(float3x3(I.M1, I.M2, I.M3), mix.xyz);

	 	 	G 		= 	g_R+g_G+g_B+g_A;

	 // Sample terrain PBR textures and blend by mask
	 float metal_R = s_metallic_r.Sample(smp_base, I.tcdbump).r * mask.r;
	 float metal_G = s_metallic_g.Sample(smp_base, I.tcdbump).r * mask.g;
	 float metal_B = s_metallic_b.Sample(smp_base, I.tcdbump).r * mask.b;
	 float metal_A = s_metallic_a.Sample(smp_base, I.tcdbump).r * mask.a;
	 float terrain_metallic = metal_R + metal_G + metal_B + metal_A;

	 float rough_R = s_roughness_r.Sample(smp_base, I.tcdbump).r * mask.r;
	 float rough_G = s_roughness_g.Sample(smp_base, I.tcdbump).r * mask.g;
	 float rough_B = s_roughness_b.Sample(smp_base, I.tcdbump).r * mask.b;
	 float rough_A = s_roughness_a.Sample(smp_base, I.tcdbump).r * mask.a;
	 float terrain_roughness = rough_R + rough_G + rough_B + rough_A;

	 float ao_R = s_ao_r.Sample(smp_base, I.tcdbump).r * mask.r;
	 float ao_G = s_ao_g.Sample(smp_base, I.tcdbump).r * mask.g;
	 float ao_B = s_ao_b.Sample(smp_base, I.tcdbump).r * mask.b;
	 float ao_A = s_ao_a.Sample(smp_base, I.tcdbump).r * mask.a;
	 float terrain_ao = ao_R + ao_G + ao_B + ao_A;
  # else
	float3	N 	= I.N.xyz	;
  # endif

 # else
	D.rgb	= 2*D.rgb*s_detail.Sample( smp_base, I.tcdbump).rgb;
 # endif
# else
	float3	N 	= I.N.xyz	;
# endif

	// Normalize normal (view space)
	float3 Nv = normalize(N);

	// Transform to world space for PBR lighting
	float3 Nw = viewDirToWorld(Nv);

	// Get world position from view position
	float3 worldPos = viewPosToWorld(I.position.xyz);

	// Extract material properties from PBR textures
	float3 albedo = D.rgb;
#ifdef USE_4_BUMP
	// Use blended terrain PBR values
	float roughness = terrain_roughness;
	float metallic = terrain_metallic;
	float ao = terrain_ao;
#else
	float roughness = s_roughness.Sample(smp_base, I.tcdh).r;
	float metallic = s_metallic.Sample(smp_base, I.tcdh).r;
	float ao = s_ao.Sample(smp_base, I.tcdh).r;
#endif

	// Get hemisphere occlusion
#ifdef USE_LM_HEMI
	float hemi = s_hemi.Sample(smp_rtlinear, I.lmh).a;
#else
	float hemi = I.position.w;
#endif

	// PBR Forward+ lighting
	return output_forward_pbr(albedo, Nw, worldPos, metallic, roughness, ao, hemi);
}
