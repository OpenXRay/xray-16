#include "common.h"
#include "sload.h"

#define	USE_4_DETAIL

#if defined(USE_TDETAIL) && defined(USE_4_DETAIL)
#	define	USE_4_BUMP
#endif

#ifdef USE_4_BUMP
f_forward 	main	( p_bumped I 	)
#else
f_forward 	main	( p_flat I 		)
#endif
{
 	// Diffuse albedo
	float4 D		= tbase		(I.tcdh);			// IN:  rgb.a
	float4 L 	= s_lmap.Sample( smp_base, I.tcdh);

	float	G	= def_gloss	;

# ifdef	USE_TDETAIL
 # ifdef USE_4_DETAIL
	// 4-layer detail texture blending
	float4	mask= s_mask.Sample ( smp_base, I.tcdh);
	float 	mag	= dot 		(mask,1);
			mask= mask/mag	;

	float3	d_R	= s_dt_r.Sample ( smp_base, I.tcdbump).rgb*mask.r;
	float3	d_G	= s_dt_g.Sample ( smp_base, I.tcdbump).rgb*mask.g;
	float3	d_B	= s_dt_b.Sample ( smp_base, I.tcdbump).rgb*mask.b;
	float3	d_A	= s_dt_a.Sample ( smp_base, I.tcdbump).rgb*mask.a;
	float3	dt	= d_R+d_G+d_B+d_A;
		D.rgb	= 2*D.rgb*dt	 ;

  # ifdef USE_4_BUMP
 	 float4	n_Rt = s_dn_r.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_Gt = s_dn_g.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_Bt = s_dn_b.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_At = s_dn_a.Sample ( smp_linear, I.tcdbump).wzyx;

 	 float3	n_R = (n_Rt.xyz-0.5)*mask.r; float g_R=n_Rt.w*mask.r;
	 float3	n_G = (n_Gt.xyz-0.5)*mask.g; float g_G=n_Gt.w*mask.g;
	 float3	n_B = (n_Bt.xyz-0.5)*mask.b; float g_B=n_Bt.w*mask.b;
	 float3	n_A = (n_At.xyz-0.5)*mask.a; float g_A=n_At.w*mask.a;

	 float3	mix		= 	n_R+n_G+n_B+n_A;
			mix.z	*=	0.5;		//. make bump twice as contrast (fake, remove me if possible)
	 float3	N		= 	mul     	(float3x3(I.M1, I.M2, I.M3), mix.xyz);

	 	 	G 		= 	g_R+g_G+g_B+g_A;
  # else
	float3	N 	= I.N.xyz	;
  # endif

 # else
	D.rgb	= 2*D.rgb*s_detail.Sample( smp_base, I.tcdbump).rgb;
 # endif
# else
	float3	N 	= I.N.xyz	;
# endif

  // Normalize normal
  float3 Ne = normalize(N);

  // Extract material properties
  float3 albedo = D.rgb;
  float roughness = 1.0 - G;  // Convert gloss to roughness
  float metallic = 0.0;  // TODO: Sample from PBR material texture in Phase 3.1

  // Forward+ output (Phase 3.0: unlit albedo)
  return output_forward_color(albedo, Ne, metallic, roughness);
}
