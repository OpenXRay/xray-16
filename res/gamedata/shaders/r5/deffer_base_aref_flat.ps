#include "common.h"
#include "sload.h"

#ifdef	ATOC

float4 	main	( p_flat I ) : SV_Target
{
	float4 D 	= tbase	 	(I.tcdh);
	D.w = (D.w-def_aref*0.5f)/(1-def_aref*0.5f);
	return D;
}

#else

f_forward 	main	( p_flat I )
{
  float4 D 	= tbase	 	(I.tcdh);
  clip(D.w - def_aref);

#ifdef	USE_TDETAIL
	D.rgb	= 2*D.rgb * s_detail.Sample( smp_base, I.tcdbump ).rgb;
#endif

  float3 Ne = normalize((float3)I.N.xyz);

  float3 albedo = D.rgb;
  float roughness = 1.0 - def_gloss;
  float metallic = 0.0;

  return output_forward_color(albedo, Ne, metallic, roughness);
}

#endif
