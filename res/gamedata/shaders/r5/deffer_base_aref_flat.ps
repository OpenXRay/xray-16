#include "common.h"
#include "sload.h"

#ifdef ATOC

float4 main( p_flat I ) : SV_Target
{
	float4 D = tbase(I.tcdh);
	D.w = (D.w - def_aref * 0.5f) / (1 - def_aref * 0.5f);
	return D;
}

#else

f_forward main( p_flat I )
{
	float4 D = tbase(I.tcdh);
	clip(D.w - def_aref);

#ifdef USE_TDETAIL
	D.rgb = 2 * D.rgb * s_detail.Sample(smp_base, I.tcdbump).rgb;
#endif

	float3 Nv = normalize((float3)I.N.xyz);

	float3 Nw = viewDirToWorld(Nv);

	float3 worldPos = viewPosToWorld(I.position.xyz);

	float3 albedo = D.rgb;
	float4 pbr = s_pbr.Sample(smp_base, I.tcdh);
	float metallic  = pbr.r;
	float roughness = pbr.g;
	float ao        = pbr.b;

#ifdef USE_LM_HEMI
	float hemi = s_hemi.Sample(smp_rtlinear, I.lmh).a;
#else
	float hemi = I.position.w;
#endif

	return output_forward_pbr(albedo, Nw, worldPos, metallic, roughness, ao, hemi);
}

#endif
