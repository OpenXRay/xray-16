#include "common.h"
#include "bindless_common.h"

float4 main ( p_TL I ) : SV_Target
{
	float uiScale = max(_pad_eye, 1e-4);
	float3 rgb = I.Color.rgb;
	float a = I.Color.a;
	if (I.TexIdx != INVALID_TEXTURE_INDEX)
	{
		float4 c = GetBindlessTexture(I.TexIdx).Sample( smp_base, I.Tex0 ) * I.Color;
		rgb = c.rgb;
		a = c.a;
	}
	if (_pad_eye < 0.999)
		rgb = SRGBToLinear(rgb);
	return float4(rgb * uiScale, a);
}
