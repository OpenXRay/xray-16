// trail.ps
// Trail pixel shader — identical to ribbon.ps
// Samples diffuse from bindless material, applies vertex color alpha.
#define SM_6_0
#include "common.h"
#include "bindless_common.h"

struct PS_INPUT
{
    float4 hpos     : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color    : TEXCOORD1;
};

float4 main(PS_INPUT input) : SV_Target0
{
    // Debug: visualize UV coordinates
    return float4(input.texcoord.x, input.texcoord.y, 0.0, input.color.a);
}
