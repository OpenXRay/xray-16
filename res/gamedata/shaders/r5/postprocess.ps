#include "shared/common.h"

cbuffer PostProcessParams : register(b3)
{
    float4 pp_dual_r0;
    float4 pp_dual_r1;
    float4 pp_dual_l0;
    float4 pp_dual_l1;
    float4 pp_noise0;
    float4 pp_noise1;
    float4 pp_color;
    float4 pp_gray;
    float4 pp_brightness;
    float4 pp_colormap;
    float4 pp_mode;
};

#define PNV_ZOOM_DEVIATION_DEFINED
static float4 m_zoom_deviation;
#include "pnv.h"

Texture2D s_base0 : register(t0);
Texture2D s_base1 : register(t1);
Texture2D s_noise : register(t2);
Texture2D s_grad0 : register(t3);
Texture2D s_grad1 : register(t4);
SamplerState smp_rtlinear : register(s0);
SamplerState smp_base : register(s1);

struct PS_INPUT
{
    float4 pos : SV_Position;
    float2 uv  : TEXCOORD0;
};

float2 Lerp2(float2 a, float2 b, float2 t)
{
    return float2(lerp(a.x, b.x, t.x), lerp(a.y, b.y, t.y));
}

float Hash21(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float4 main(PS_INPUT I) : SV_Target
{
    float2 uv = I.uv;
    float2 uv0 = Lerp2(pp_dual_r0.xy, pp_dual_r1.xy, uv);
    float2 uv1 = Lerp2(pp_dual_l0.xy, pp_dual_l1.xy, uv);
    float2 uvn = Lerp2(pp_noise0.xy, pp_noise1.xy, uv);

    float3 t_0 = s_base0.Sample(smp_rtlinear, uv0).rgb;
    float3 t_1 = s_base1.Sample(smp_rtlinear, uv1).rgb;
    float3 image = (t_0 + t_1) * 0.5;
    float3 image_o = image;

    if (pp_colormap.x > 0.001)
    {
        float grad_i = saturate(dot(image_o, float3(0.3333, 0.3333, 0.3333)));
        float3 image0 = s_grad0.Sample(smp_rtlinear, float2(grad_i, 0.5)).rgb;
        float3 image1 = s_grad1.Sample(smp_rtlinear, float2(grad_i, 0.5)).rgb;
        float3 graded = lerp(image0, image1, pp_colormap.y);
        float gLum = max(dot(graded, float3(0.2126, 0.7152, 0.0722)), 1e-4);
        float iLum = max(dot(image_o, float3(0.2126, 0.7152, 0.0722)), 1e-4);
        float3 gradedLum = image_o * (gLum / iLum);
        image = lerp(image_o, gradedLum, saturate(pp_colormap.x));
    }

    float gray = dot(image, pp_gray.rgb);
    image = lerp(float3(gray, gray, gray), image, pp_gray.w);

    float4 t_noise = s_noise.Sample(smp_base, uvn);
    float nLen = length(t_noise.rgb - 0.5);
    if (nLen < 0.02)
    {
        float2 cell = floor(uvn * float2(256.0, 256.0));
        float n0 = Hash21(cell);
        float n1 = Hash21(cell + 17.0);
        float n2 = Hash21(cell + 41.0);
        t_noise = float4(n0, n1, n2, 1.0);
    }
    float3 noised = image * t_noise.rgb * 2.0;
    image = lerp(noised, image, pp_color.w);

    float3 c = pp_color.rgb;
    float3 b = pp_brightness.rgb;
    float cLum = max(dot(c, float3(0.2126, 0.7152, 0.0722)), 1e-3);
    float bLum = dot(b, float3(0.2126, 0.7152, 0.0722));
    c = float3(cLum, cLum, cLum);
    b = float3(bLum, bLum, bLum);
    image = (image * c + b) * 2.0;

    float4 color = float4(image, 1.0);
    if (pp_mode.x > 0.5 && pp_mode.x < 1.5)
    {
        m_zoom_deviation = float4(0.0, 0.0, max(pp_mode.y, 1.0), 0.0);
        color = calc_night_vision_effect(uv, color, float3(0.1, 1.0, 0.2));
    }

    return color;
}
