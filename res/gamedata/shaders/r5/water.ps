#define SM_6_0
#define USE_SOFT_WATER
#define NEED_SOFT_WATER
#include "common.h"
#include "bindless_common.h"
#include "shared/ssr.h"
#include "shared/surface_marks.h"

struct PS_INPUT
{
    float4 hpos     : SV_Position;
    float2 tbase    : TEXCOORD0;
    float2 tnorm0   : TEXCOORD1;
    float2 tnorm1   : TEXCOORD2;
    float3 M1       : TEXCOORD3;
    float3 M2       : TEXCOORD4;
    float3 M3       : TEXCOORD5;
    float3 v2point  : TEXCOORD6;
    float4 c0       : COLOR0;
    float  fog      : TEXCOORD7;
    nointerpolation uint materialID : TEXCOORD8;
    float4 tctexgen : TEXCOORD9;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

TextureCube s_env0 : register(t25);
TextureCube s_env1 : register(t26);
Texture2D s_leaves : register(t22);
Texture2D g_UnderWorldPos : register(t23);

cbuffer WaterParams : register(b5)
{
    float4 water_intensity;
};

float2 WaterScreenUV(float4 tctexgen)
{
    float2 ndc = tctexgen.xy / max(tctexgen.w, 1e-5);
    return float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
}

float3 SampleWaterNormal(MaterialData mat, float2 uv0, float2 uv1)
{
    float3 n0 = float3(0.5, 0.5, 1.0);
    float3 n1 = float3(0.5, 0.5, 1.0);
    if (mat.normalIndex != INVALID_TEXTURE_INDEX)
    {
        n0 = GetBindlessTexture(mat.normalIndex).Sample(smp_base, uv0).xyz;
        n1 = GetBindlessTexture(mat.normalIndex).Sample(smp_base, uv1).xyz;
    }
    float3 n = n0 + n1 - 1.0;
    n.xy *= 0.18;
    n = normalize(lerp(float3(0.0, 0.0, 1.0), n, 0.35));
    return n;
}

PS_OUTPUT main(PS_INPUT I)
{
    MaterialData mat = g_Materials[I.materialID];
    if ((mat.flags & MAT_FLAG_WATER) == 0)
        clip(-1);

    float4 base = SampleDiffuse(mat, I.tbase);
    float3 Navg = SampleWaterNormal(mat, I.tnorm0, I.tnorm1);
    float3 Nw = normalize(mul(float3x3(I.M1, I.M2, I.M3), Navg));
    Nw = normalize(lerp(float3(0.0, 1.0, 0.0), Nw, 0.45));
    float3 v2point = normalize(I.v2point);
    float3 vreflect = reflect(v2point, Nw);
    vreflect.y = vreflect.y * 2.0 - 1.0;

    float3 env0 = s_env0.SampleLevel(smp_base, vreflect, 0).rgb;
    float3 env1 = s_env1.SampleLevel(smp_base, vreflect, 0).rgb;
    float3 env = lerp(env0, env1, L_ambient.w);
    env = max(env, float3(0.12, 0.14, 0.16));
    env *= 2.2;
    env *= max(L_hemi_color.rgb + L_ambient.rgb, float3(0.35, 0.38, 0.42));

    float3 worldPos = I.v2point + eye_position.xyz;
    {
        float3 Nssr = normalize(lerp(Nw, float3(0.0, 1.0, 0.0), 0.45));
        float4 ssr = compute_ssr_ex(worldPos, Nssr, env, 28, 120.0, 1.75, 4, 0.0);
        env = lerp(env, ssr.xyz, saturate(ssr.w));
    }

    float NdotV = saturate(abs(dot(Nw, -v2point)));
    float fresnel = pow(1.0 - NdotV, 5.0);
    float amount = saturate(0.38 + 0.4 * fresnel);

    float3 c_reflection = env * (0.7 + 0.3 * fresnel);
    float3 bodyLit = base.rgb * max(I.c0.rgb, float3(0.2, 0.22, 0.2)) * water_intensity.xxx;
    float3 murk = float3(0.05, 0.07, 0.06);
    float3 body = lerp(bodyLit, murk, 0.72);
    float3 finalColor = lerp(body, c_reflection, amount);

    float alpha = 0.35 + 0.4 * amount;

#ifdef USE_SOFT_WATER
    float2 PosTc = WaterScreenUV(I.tctexgen);
    float sceneRaw = 0.0;
    float sceneViewZ = SampleSceneViewZ(PosTc, sceneRaw);
    float waterViewZ = abs(I.tctexgen.z);
    float waterDepth = max(0.0, sceneViewZ - waterViewZ);

    float4 underWP = g_UnderWorldPos.SampleLevel(smp_nofilter, PosTc, 0);
    if (underWP.w > 0.5 && !IsWaterSurfMark(underWP.w))
    {
        float underDist = length(underWP.xyz - eye_position.xyz);
        float waterDist = length(worldPos - eye_position.xyz);
        waterDepth = max(0.0, underDist - waterDist);
    }

    float softShore = smoothstep(0.0, 1.6, waterDepth);
    float depthFog = 1.0 - exp(-2.8 * waterDepth);
    float3 absorb = float3(0.035, 0.05, 0.045) * water_intensity.r;
    finalColor = lerp(absorb, finalColor, lerp(0.15, 0.85, depthFog));
    finalColor = lerp(finalColor, murk * water_intensity.r, 0.22 * depthFog);

    alpha = min(alpha, saturate(waterDepth * 1.15));
    alpha = max(alpha * softShore, depthFog * 0.28);
    alpha = saturate(alpha * softShore + depthFog * 0.2);

    float4 leaves = s_leaves.Sample(smp_base, I.tbase);
    leaves.rgb *= water_intensity.r;
    float calc_cos = saturate(-dot(float3(I.M1.z, I.M2.z, I.M3.z), v2point));
    float calc_depth = saturate(waterDepth * calc_cos);
    float fLeavesFactor = smoothstep(0.025, 0.05, calc_depth);
    fLeavesFactor *= smoothstep(0.1, 0.075, calc_depth);
    fLeavesFactor *= softShore;
    finalColor = lerp(finalColor, leaves.rgb, leaves.a * fLeavesFactor);
    alpha = lerp(alpha, max(alpha, leaves.a * softShore), leaves.a * fLeavesFactor);
#endif

    float fogFactor = saturate(I.fog);
    finalColor = lerp(fog_color.xyz, finalColor, fogFactor);
    alpha *= fogFactor * fogFactor;

    float3 Nenc = Nw * 0.5 + 0.5;
    float gloss = saturate(0.7 + 0.25 * amount);

    PS_OUTPUT O;
    O.color = float4(finalColor, saturate(alpha));
    O.normal = float4(Nenc, gloss);
    O.baseColor = float4(body, SURF_MARK_WATER);
    O.worldPos = float4(worldPos, SURF_MARK_WATER);
    return O;
}
