#define SM_6_0
#define CLUSTERED_LIGHTING_FORWARD
#include "common.h"
#include "bindless_common.h"
#include "shared/parallax.h"
#include "shared/surface_marks.h"

struct PS_INPUT
{
    float4 position : SV_Position;
    float3 worldPos : TEXCOORD0;
    float2 texcoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 bitangent : TEXCOORD4;
    nointerpolation uint materialID : TEXCOORD5;
    float hemi : TEXCOORD6;
    float2 lmUV : TEXCOORD7;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    MaterialData mat = g_Materials[input.materialID];

    if (mat.flags & MAT_FLAG_WATER)
        clip(-1);

    float3 Ngeom = normalize(input.normal);
    float2 uv = ApplyMaterialParallaxUV(mat, input.texcoord, input.tangent, input.bitangent, Ngeom, input.worldPos);
    float4 diffuseSample = SampleDiffuse(mat, uv);
    const bool isGlass = (mat.flags & MAT_FLAG_GLASS) != 0;

    if (mat.flags & MAT_FLAG_ALPHA_TEST)
    {
        clip(diffuseSample.a - mat.alphaRef);
    }

    float3 albedo = diffuseSample.rgb;
    if (isGlass)
    {
        float3 Vdir = normalize(eye_position - input.worldPos);
        float3 R = reflect(-Vdir, Ngeom);
        float3 e0 = env_s0.SampleLevel(smp_rtlinear, R, 0).rgb;
        float3 e1 = env_s1.SampleLevel(smp_rtlinear, R, 0).rgb;
        float3 env = lerp(e0, e1, saturate(L_ambient.w));
        albedo = lerp(env, diffuseSample.rgb, diffuseSample.a);
    }

    float3 N = Ngeom;
    float gloss = 0.0;
    if (mat.flags & MAT_FLAG_HAS_NORMAL)
    {
        BumpSample bump = SampleNormal(mat, uv);
        float3x3 TBN = float3x3(
            normalize(input.tangent),
            normalize(input.bitangent),
            N
        );
        float3 Nt = normalize(mul(bump.normal, TBN));
        if (all(isfinite(Nt)) && dot(Nt, N) > 0.2)
            N = Nt;
        gloss = bump.gloss;
    }

    if (!isGlass && (mat.flags & MAT_FLAG_HAS_DETAIL))
    {
        float4 detailSample = SampleDetail(mat, uv);
        albedo = albedo * (detailSample.rgb * 2.0);
    }

    float metallic = 0.0;
    float roughness = 1.0 - gloss;
    float ao = 1.0;

    if (mat.flags & MAT_FLAG_HAS_PBR)
    {
        float3 pbrSample = SamplePBR(mat, uv);
        metallic = pbrSample.r;
        roughness = pbrSample.g;
        ao = pbrSample.b;
    }
    float hemi = input.hemi;
    if (hemi < 0.0)
        hemi = (parallax.w < -0.5) ? 0.0 : calc_model_hemi(N);
    float sunOcc = 1.0;
    bool hasLmap = false;
    if ((mat.flags & MAT_FLAG_HAS_LMAP) != 0 && mat.lmapIndex != INVALID_TEXTURE_INDEX
        && dot(input.lmUV, input.lmUV) > 1e-8)
    {
        float4 lmh = GetBindlessTexture(mat.lmapIndex).Sample(smp_rtlinear, input.lmUV);
        float bakedHemi = saturate(get_hemi(lmh));
        hemi = bakedHemi;
        sunOcc = saturate(get_sun(lmh));
        hasLmap = true;
    }

    f_forward fwd = output_forward_pbr(
        albedo, N, input.worldPos, metallic, roughness, ao, input.position, hemi, sunOcc, hasLmap);
    float3 lit = fwd.color.rgb;
    float outA = fwd.color.a;
    if ((mat.flags & MAT_FLAG_ALPHA_BLEND) != 0 && (mat.flags & MAT_FLAG_HAS_LMAP) == 0)
        outA = diffuseSample.a;
    if (isGlass)
    {
        float fog = saturate(dot(float4(input.worldPos, 1.0), fog_plane));
        outA = diffuseSample.a * fog * fog;
    }
    output.color = float4(lit, outA);
    output.normal = fwd.normal;
    float luma = dot(albedo, float3(0.299, 0.587, 0.114));
    float chroma = length(albedo - luma);
    float gDom = albedo.g - max(albedo.r, albedo.b);
    bool leafTint = metallic < 0.18 && chroma > 0.07 && albedo.g > 0.08 && gDom > -0.03;
    bool foliage = ((mat.flags & MAT_FLAG_FOLIAGE) != 0) && leafTint;
    if (!foliage && (mat.flags & MAT_FLAG_ALPHA_TEST) != 0 && (mat.flags & MAT_FLAG_ALPHA_BLEND) == 0)
        foliage = leafTint && (mat.flags & MAT_FLAG_TWO_SIDED) != 0;
    float mark = 0.0;
    if (hasLmap && sunOcc < 0.2)
        mark = SURF_MARK_INTERIOR;
    else if (foliage)
        mark = SURF_MARK_FOLIAGE;
    float sssMask = foliage ? 0.7 : 0.0;
    output.baseColor = float4(fwd.baseColor.rgb, PackBaseColorA(metallic, sssMask));
    output.worldPos = float4(input.worldPos, mark);
    return output;
}
