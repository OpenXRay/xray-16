// bindless_forward.ps
// SM6 Bindless forward pixel shader
// Uses ResourceDescriptorHeap[NonUniformResourceIndex(index)] for texture access
// MaterialData contains descriptor heap indices (diffuseIndex, normalIndex, etc.)
// Uses static_globals (b2) for lighting - same values as legacy renderer

#define SM_6_0
#define CLUSTERED_LIGHTING_FORWARD
#include "common.h"
#include "bindless_common.h"
#include "cluster_fade.h"

struct PS_INPUT
{
    float4 position : SV_Position;
    float3 worldPos : TEXCOORD0;
    float2 texcoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 bitangent : TEXCOORD4;
    nointerpolation uint materialID : TEXCOORD5;  // Direct material ID (no indirection)
    nointerpolation uint drawID : TEXCOORD6;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
};

// Lighting uses static_globals from common.h (b2):
// - L_sun_color, L_sun_dir_w (sun)
// - L_ambient (ambient)
// - eye_position (camera)
// - fog_params, fog_color (fog)

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    uint fadeWord = g_DrawFades[input.drawID];
    ClusterFadeDiscard(fadeWord, input.position);

    // DEBUG: Visualize UVs as color to find where black areas are in UV space
    // Uncomment ONE of these to debug:

    // Option 1: Show UV coordinates as RG color (frac to see tiling)
    //output.color = float4(frac(input.texcoord.x), frac(input.texcoord.y), 0, 1);
    //return output;

    // Option 2: Show material ID as grayscale
    //output.color = float4(input.materialID / 255.0, input.materialID / 255.0, input.materialID / 255.0, 1);
    //return output;

    // Get material data directly using material ID
    MaterialData mat = g_Materials[input.materialID];


    // Sample textures using SM6 bindless (ResourceDescriptorHeap)
    float4 diffuseSample = SampleDiffuse(mat, input.texcoord);

    // DEBUG: Visualize material ID (drawIndex) - use brighter colors
    //float r = (input.materialID % 7) / 6.0;
    //float g = (input.materialID % 5) / 4.0 + 0.3;
    //float b = (input.materialID % 3) / 2.0 + 0.5;
    //output.color = float4(r, g, b, 1);
    //return output;

    // Alpha test
    if (mat.flags & MAT_FLAG_ALPHA_TEST)
    {
        clip(diffuseSample.a - mat.alphaRef);
    }

    float3 albedo = diffuseSample.rgb;

    float3 N = normalize(input.normal);
    float gloss = 0.0;
    if (mat.flags & MAT_FLAG_HAS_NORMAL)
    {
        BumpSample bump = SampleNormal(mat, input.texcoord);
        float3x3 TBN = float3x3(
            normalize(input.tangent),
            normalize(input.bitangent),
            N
        );
        N = normalize(mul(bump.normal, TBN));
        gloss = bump.gloss;
    }

    // Detail texture
    if (mat.flags & MAT_FLAG_HAS_DETAIL)
    {
        // Detail sampling (uses mat.detailScale internally)
        float4 detailSample = SampleDetail(mat, input.texcoord);
        // Blend detail (multiply-2x style)
        albedo = albedo * (detailSample.rgb * 2.0);
    }

    float metallic = 0.0;
    float roughness = 1.0 - gloss;
    float ao = 1.0;

    if (mat.flags & MAT_FLAG_HAS_PBR)
    {
        float3 pbrSample = SamplePBR(mat, input.texcoord);
        metallic = pbrSample.r;
        roughness = pbrSample.g;
        ao = pbrSample.b;
    }

    f_forward fwd = output_forward_pbr(albedo, N, input.worldPos, metallic, roughness, ao, input.position);
    output.color = float4(fwd.color.rgb, diffuseSample.a);
    output.normal = fwd.normal;
    output.baseColor = fwd.baseColor;

    if (dev_param_4.x > 0.5)
    {
        uint mode = uint(dev_param_4.x);
        if (mode == 3u)
        {
            uint errClass = (fadeWord >> 16) & 3u;
            float3 classColors[4] = {
                float3(0.1, 0.8, 0.1), float3(0.9, 0.9, 0.1),
                float3(0.9, 0.2, 0.1), float3(0.0, 0.0, 0.0)
            };
            output.color.rgb = classColors[errClass];
        }
        else if (mode == 4u)
        {
            uint fA = 63u - (fadeWord & 63u);
            uint fB = (fadeWord >> 6) & 63u;
            output.color.rgb = float3(float(63u - fA) / 63.0, float(fB) / 63.0, (fA < 63u || fB > 0u) ? 1.0 : 0.0);
        }
        else
        {
            uint seed = (mode == 2u) ? ((fadeWord >> 12) & 15u) : (fadeWord >> 18);
            uint h = seed * 747796405u + 2891336453u;
            h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
            h = (h >> 22u) ^ h;
            float3 tint = float3(float(h & 255u), float((h >> 8) & 255u), float((h >> 16) & 255u)) / 255.0;
            output.color.rgb = tint;
        }
    }

    return output;
}
