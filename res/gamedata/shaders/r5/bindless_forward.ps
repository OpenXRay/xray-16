// bindless_forward.ps
// SM6 Bindless forward pixel shader
// Uses ResourceDescriptorHeap[NonUniformResourceIndex(index)] for texture access
// MaterialData contains descriptor heap indices (diffuseIndex, normalIndex, etc.)
// Uses static_globals (b2) for lighting - same values as legacy renderer

#define SM_6_0
#define CLUSTERED_LIGHTING_FORWARD
#define CSM_SHADOW_FORWARD
#define LOCAL_SHADOW_FORWARD
#define SKY_IBL
// CSM: PCSS + cascade depth select (bust shader cache when sampling.h changes)
#include "common.h"
#include "bindless_common.h"
// Water materials are drawn by dedicated water.vs/ps in TransparentPass.
// s_env0/s_env1 declared via shared/sky_ibl.h (SKY_IBL)

struct PS_INPUT
{
    float4 position : SV_Position;
    float3 worldPos : TEXCOORD0;
    float2 texcoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 bitangent : TEXCOORD4;
    nointerpolation uint materialID : TEXCOORD5;  // Direct material ID (no indirection)
    float hemi : TEXCOORD6;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

// Object steep parallax (classic sload.h ALLOW_STEEPPARALLAX) on bump# height
// (normalX.a). Offsets UV before texturing so relief shows on walls/props.
// Disabled (returns uv) when: parallax off (parallax.x<=0), no bump#, grazing
// angle, distance fade, or on alpha-test / foliage (billboards have no real depth).
float2 ObjectParallaxUV(MaterialData mat, float2 uv, float3 worldPos,
                        float3 T, float3 B, float3 N)
{
    if (parallax.x <= 0.0)
        return uv;
    if ((mat.flags & MAT_FLAG_HAS_NORMAL_X) == 0 || mat.normalXIndex == INVALID_TEXTURE_INDEX)
        return uv;
    if (mat.flags & (MAT_FLAG_ALPHA_TEST | MAT_FLAG_FOLIAGE))
        return uv;

    float3 V = normalize(eye_position - worldPos);
    float3 Vts = normalize(float3(dot(V, T), dot(V, B), dot(V, N)));
    if (Vts.z < 0.02)
        return uv;

    float viewZ = abs(mul(m_V, float4(worldPos, 1.0)).z);
    const float startFade = 8.0;
    const float stopFade = 20.0;
    if (viewZ >= stopFade)
        return uv;

    const float maxSamples = 16.0;
    const float minSamples = 6.0;
    float nSteps = lerp(maxSamples, minSamples, saturate(Vts.z));
    float stepSize = 1.0 / nSteps;
    float2 vDelta = Vts.xy * (-parallax.x) * 1.2;
    float2 offPerStep = stepSize * vDelta;

    Texture2D hx = GetBindlessTexture(mat.normalXIndex);
    float2 curOff = uv;
    float curH = 0.0;
    float curBound = 1.0;

    [loop]
    for (int i = 0; i < (int)nSteps; ++i)
    {
        if (curH < curBound)
        {
            curOff += offPerStep;
            curH = hx.Sample(smp_linear, curOff).a;
            curBound -= stepSize;
        }
    }

    float2 prevOff = curOff - offPerStep;
    float prevH = hx.Sample(smp_linear, prevOff).a;
    float d2 = (curBound + stepSize) - prevH;
    float d1 = curBound - curH;
    float denom = d2 - d1;
    float amt = (abs(denom) > 1e-5)
        ? (curBound * d2 - (curBound + stepSize) * d1) / denom
        : curBound;
    float fade = smoothstep(stopFade, startFade, viewZ);
    return uv + vDelta * ((1.0 - amt) * fade);
}

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    MaterialData mat = g_Materials[input.materialID];

    // ── Water drawn by dedicated water PSO (TransparentPass second draw) ──
    if (mat.flags & MAT_FLAG_WATER)
        clip(-1);

    float3 Tn = normalize(input.tangent);
    float3 Bn = normalize(input.bitangent);
    float3 Ngeom = normalize(input.normal);
    float2 uv = ObjectParallaxUV(mat, input.texcoord, input.worldPos, Tn, Bn, Ngeom);

    float4 diffuseSample = SampleDiffuse(mat, uv);

    if (mat.flags & MAT_FLAG_ALPHA_TEST)
    {
        clip(diffuseSample.a - mat.alphaRef);
    }

    float3 albedo = diffuseSample.rgb;

    float3 N = Ngeom;
    float gloss = 0.0;
    if (mat.flags & MAT_FLAG_HAS_NORMAL)
    {
        BumpSample bump = SampleNormal(mat, uv);
        float3x3 TBN = float3x3(Tn, Bn, N);
        N = normalize(mul(bump.normal, TBN));
        gloss = bump.gloss;
    }

    if (mat.flags & MAT_FLAG_HAS_DETAIL)
    {
        float4 detailSample = SampleDetail(mat, uv);
        albedo = albedo * (detailSample.rgb * 2.0);
        // Non-bump detail path modulates gloss from detail alpha (sload.h)
        if (!(mat.flags & MAT_FLAG_HAS_DETAIL_BUMP))
            gloss = gloss * detailSample.a * 2.0;
    }

    float metallic = 0.0;
    float roughness = 1.0 - gloss;
    float ao = 1.0;

    if (mat.flags & MAT_FLAG_HAS_PBR)
    {
        float3 pbrSample = SamplePBR(mat, uv);
        metallic = pbrSample.r;
        roughness = pbrSample.g;
        ao = pbrSample.b;
    }

    // Foliage SSS: default thickness=1; optional thickness map in detailBumpX (R)
    float sssStrength = 0.0;
    float3 sssTint = float3(0.45, 0.65, 0.22);
    float sssThickness = 1.0;
    if (mat.flags & MAT_FLAG_FOLIAGE)
    {
        // parallax.z = global foliage SSS intensity (see FillGlobalConstants)
        sssStrength = max(parallax.z, 0.0);
        // Leaf alpha: thinner at transparent edges
        if (mat.flags & MAT_FLAG_ALPHA_TEST)
            sssThickness = saturate(diffuseSample.a + 0.2);
        if (mat.flags & MAT_FLAG_HAS_SSS_MAP)
        {
            // Future: dedicated SSS thickness texture (R = thick→less scatter)
            float thickMap = GetBindlessTexture(mat.detailBumpXIndex).Sample(smp_linear, input.texcoord).r;
            sssThickness *= saturate(1.0 - thickMap);
        }
    }

    f_forward fwd = output_forward_pbr(
        albedo, N, input.worldPos, metallic, roughness, ao, input.position, input.hemi, 1.0,
        sssStrength, sssTint, sssThickness);
    output.color = float4(fwd.color.rgb, diffuseSample.a);
    output.normal = fwd.normal;
    output.baseColor = fwd.baseColor;
    output.worldPos = fwd.worldPos;
    return output;
}
