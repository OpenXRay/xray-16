//#define SM_4_1

float4 sm_gather( float2 tc, int2 offset )
{
#ifdef SM_4_1
	return s_smap.Gather( smp_nofilter, tc, offset );
#else
    static const float scale = float( SMAP_size );
	float2 fc = frac( tc * scale );

	tc -= fc / scale;

	// Adjust texture coordinates by offset (must avoid runtime offset in SampleLevel)
	float2 pixel_size = 1.0f / float( SMAP_size );
	float2 tc_offset = tc + float2(offset) * pixel_size;

	float s0 = s_smap.SampleLevel( smp_nofilter, tc_offset + float2( 0, 1 ) * pixel_size, 0 ).r;
	float s1 = s_smap.SampleLevel( smp_nofilter, tc_offset + float2( 1, 1 ) * pixel_size, 0 ).r;
	float s2 = s_smap.SampleLevel( smp_nofilter, tc_offset + float2( 1, 0 ) * pixel_size, 0 ).r;
	float s3 = s_smap.SampleLevel( smp_nofilter, tc_offset + float2( 0, 0 ) * pixel_size, 0 ).r;

	return float4( s0, s1, s2, s3 );
#endif
}

float4 sm_minmax_gather( float2 tc, int2 offset )
{
#ifdef SM_4_1
	return s_smap_minmax.Gather( smp_nofilter, tc, offset );
#else
    static const float scale = float( SMAP_size / 4 );
	float2 fc = frac( tc * scale );

	tc -= fc / scale;

	// Adjust texture coordinates by offset (must avoid runtime offset in SampleLevel)
	float2 pixel_size = 1.0f / float( SMAP_size / 4 );
	float2 tc_offset = tc + float2(offset) * pixel_size;

	float s0 = s_smap_minmax.SampleLevel( smp_nofilter, tc_offset + float2( 0, 1 ) * pixel_size, 0 ).x;
	float s1 = s_smap_minmax.SampleLevel( smp_nofilter, tc_offset + float2( 1, 1 ) * pixel_size, 0 ).x;
	float s2 = s_smap_minmax.SampleLevel( smp_nofilter, tc_offset + float2( 1, 0 ) * pixel_size, 0 ).x;
	float s3 = s_smap_minmax.SampleLevel( smp_nofilter, tc_offset + float2( 0, 0 ) * pixel_size, 0 ).x;

	return float4( s0, s1, s2, s3 );
#endif
}
