#define SM_6_0
#define CLUSTERED_LIGHTING_FORWARD
#define CSM_SHADOW_FORWARD
#define LOCAL_SHADOW_FORWARD
#define CSM_CHEAP_FORWARD
#define SKY_IBL
#define SKY_IBL_SPEC_V4 1
#include "common.h"
#include "bindless_common.h"

cbuffer DetailGlobals : register(b3)
{
	float4 consts;
	float4 wave;
	float4 dir2D;
	float4 dir2D_2;
	float4x4 g_detail_VP;
	float4 detail_params;
	float4 g_wind_direction;
	float grass_wind_displacement;
	float grass_interaction_displacement;
	uint interaction_atlas_index;
	uint perlin4d_texture_index;
	float4 grass_color_tip;
	float4 grass_color_base;
	float4 grass_sss_color;
	float grass_color_variation;
	float grass_blade_height;
	uint build_details_index;
	uint build_details_pbr_index;
	uint grass_vein_index;
	uint _pad0, _pad1, _pad2;
};

f_forward main(p_billboard I)
{
	Texture2D atlas_tex = GetBindlessTexture(build_details_index);
	float4 texel = atlas_tex.Sample(smp_linear, I.tcdh.xy);

	clip(texel.a - 96.0 / 255.0);

	float3 albedo = texel.rgb;
	float3 N = normalize(I.N);
	float t = I.heightParam;
	float metallic = 0.0;
	float roughness = 0.85;
	float ao = lerp(0.5, 1.0, saturate(t));
	float hemi = I.position.w;

	if (build_details_pbr_index != 0)
	{
		Texture2D pbr_tex = GetBindlessTexture(build_details_pbr_index);
		float4 pbr = pbr_tex.Sample(smp_linear, I.tcdh.xy);
		metallic = pbr.r;
		roughness = pbr.g;
		ao = pbr.b;
	}

	float thickness = saturate(lerp(0.45, 1.0, t) * saturate(texel.a + 0.35));
	float sssAmt = max(grass_sss_color.w, 0.0);
	float sssMask = saturate(sssAmt * 1.6);

	return output_forward_pbr(
		albedo, N, I.position.xyz, metallic, roughness, ao, I.hpos,
		hemi, saturate(I.sunOcclusion),
		sssAmt, grass_sss_color.rgb, thickness, sssMask, 1.0);
}
