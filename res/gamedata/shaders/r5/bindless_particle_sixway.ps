#define SM_6_0
#include "common.h"
#include "bindless_common.h"
#include "shared/surface_marks.h"
#include "shared/clustered_lighting.h"

Texture2D<float4> g_SceneWorldPos : register(t1);
StructuredBuffer<GPULightData> g_LightData : register(t20);
StructuredBuffer<uint2> g_ClusterGrid : register(t21);
StructuredBuffer<uint> g_LightIndexList : register(t22);

#define DEPTH_EPSILON 0.1

struct PS_INPUT
{
    float4 hpos     : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color    : TEXCOORD1;
    float3 worldPos : TEXCOORD2;
    float3 normal   : TEXCOORD3;
    nointerpolation uint materialID : TEXCOORD4;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
    float4 normal : SV_Target1;
    float4 baseColor : SV_Target2;
    float4 worldPos : SV_Target3;
};

float3 SampleSixWay(MaterialData mat, float2 uv, float3 L)
{
    float3 posXYZ = float3(1, 1, 1);
    float3 negXYZ = float3(1, 1, 1);
    if (mat.flags & MAT_FLAG_HAS_NORMAL)
        posXYZ = GetBindlessTexture(mat.normalIndex).Sample(smp_linear, uv).rgb;
    if (mat.flags & MAT_FLAG_HAS_DETAIL)
        negXYZ = GetBindlessTexture(mat.detailIndex).Sample(smp_linear, uv).rgb;

    float3 Lp = max(L, 0.0);
    float3 Ln = max(-L, 0.0);
    return posXYZ * Lp + negXYZ * Ln;
}

float3 EvaluateParticleClustered(float3 worldPos, float3 N, float3 albedo, float2 pixelPos, float linearDepth)
{
    uint numLights = (uint)cluster_params.w;
    if (numLights == 0)
        return 0;

    uint clusterIdx = GetClusterIndexFromPixel(pixelPos, linearDepth);
    uint2 clusterData = g_ClusterGrid[clusterIdx];
    uint lightOffset = clusterData.x;
    uint lightCount = clusterData.y;

    float3 total = 0;
    for (uint i = 0; i < lightCount; i++)
    {
        uint lightIdx = g_LightIndexList[lightOffset + i];
        GPULightData light = g_LightData[lightIdx];
        float3 toLight = light.positionAndInvRangeSq.xyz - worldPos;
        float distSq = dot(toLight, toLight);
        float3 L = normalize(toLight);
        float atten = PointLightAttenuation(distSq, light.positionAndInvRangeSq.w);
        if (light.spotParamsAndType.y > 0.5f)
        {
            atten *= SpotLightAttenuation(
                toLight, light.directionAndSpotScale.xyz,
                light.directionAndSpotScale.w, light.spotParamsAndType.x);
        }
        total += albedo * light.colorAndRange.xyz * atten * saturate(dot(N, L));
    }
    return total;
}

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    MaterialData mat = g_Materials[input.materialID];
    float4 diffuseSample = SampleDiffuse(mat, input.texcoord);
    float3 albedo = diffuseSample.rgb * input.color.rgb;
    float alpha = diffuseSample.a * input.color.a;
    clip(alpha - mat.alphaRef);

    if (camera_direction.w > 0.5 && !(mat.flags & MAT_FLAG_PARTICLE_HARD))
    {
        float4 sceneWP = g_SceneWorldPos.Load(int3((int2)input.hpos.xy, 0));
        if (IsHudSurfMark(sceneWP.w))
            discard;
        if (sceneWP.w > 0.5)
        {
            float3 viewDir = camera_direction.xyz;
            float sceneViewZ = dot(sceneWP.xyz - eye_position, viewDir);
            float particleViewZ = dot(input.worldPos - eye_position, viewDir);
            float spaceDepth = sceneViewZ - particleViewZ - DEPTH_EPSILON;
            if (spaceDepth < -2 * DEPTH_EPSILON)
                spaceDepth = 100000.0;
            float soft = Contrast(saturate(spaceDepth * 1.3), 2);
            alpha *= soft;
            albedo *= soft;
        }
    }

    float3 N = normalize(input.normal);
    float linearDepth = abs(mul(m_V, float4(input.worldPos, 1.0)).z);
    float3 sunL = normalize(-L_sun_dir_w);
    float3 six = SampleSixWay(mat, input.texcoord, sunL);
    float3 lit = albedo * L_hemi_color.rgb * ((parallax.w < -0.5) ? 0.1 : 0.25);
    lit += albedo * L_sun_color.rgb * six;
    lit += EvaluateParticleClustered(input.worldPos, N, albedo, input.hpos.xy, linearDepth);
    if (parallax.w < -0.5)
        lit += albedo * L_ambient.rgb * 0.3;

    output.color = float4(lit, alpha);
    output.normal = float4(N, 1);
    output.baseColor = float4(diffuseSample.rgb, 0);
    output.worldPos = float4(input.worldPos, 1.0);
    return output;
}
