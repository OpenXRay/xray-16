// xrRender/Shaders/tonemap.ps.hlsl
// ACES Filmic tonemap with gamma correction

Texture2D t_hdr : register(t0);
SamplerState s_linear : register(s0);

struct PS_INPUT {
    float4 position : SV_POSITION;
    float2 texcoord : TEXCOORD0;
};

// ACES Filmic tonemap (Narkowicz 2015)
float3 ACESFilm(float3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return saturate((x * (a * x + b)) / (x * (c * x + d) + e));
}

float4 main(PS_INPUT input) : SV_TARGET {
    // Sample HDR color
    float3 hdr = t_hdr.Sample(s_linear, input.texcoord).rgb;

    // Apply fixed exposure (can be made configurable later via console vars)
    const float exposure = 1.0;
    hdr *= exposure;

    // Tonemap (HDR -> LDR)
    float3 ldr = ACESFilm(hdr);

    // Gamma correction - try without it first since backbuffer might handle it
    // If still too bright/dark, uncomment and adjust gamma value (2.2 = standard, higher = darker)
    // const float gamma = 2.2;
    // ldr = pow(ldr, 1.0 / gamma);

    return float4(ldr, 1.0);
}

