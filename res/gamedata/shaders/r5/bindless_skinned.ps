// bindless_skinned.ps
// SM6 Bindless forward pixel shader for SKINNED meshes
// Uses per-draw constant for material ID (not GPU-driven)
// Uses ResourceDescriptorHeap[NonUniformResourceIndex(index)] for texture access

#define SM_6_0
#include "common.h"
#include "bindless_common.h"

struct PS_INPUT
{
    float4 position : SV_Position;
    float3 worldPos : TEXCOORD0;
    float2 texcoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 bitangent : TEXCOORD4;
    nointerpolation uint materialID : TEXCOORD5;
};

struct PS_OUTPUT
{
    float4 color : SV_Target0;
};

// Per-draw material ID (set via constant buffer for skinned meshes)
// This is uploaded by FGConstantSystem for each skeleton draw
cbuffer SkinnedMaterialCB : register(b4)
{
    uint g_SkinnedMaterialID;
    uint g_SkinnedPad0;
    uint g_SkinnedPad1;
    uint g_SkinnedPad2;
};

// Simple PBR-ish lighting (same as bindless_forward.ps)
float3 CalculateLighting(float3 albedo, float3 N, float3 V, float metallic, float roughness, float ao)
{
    float3 L = -L_sun_dir_w;
    float3 H = normalize(V + L);

    float NdotL = saturate(dot(N, L));
    float NdotH = saturate(dot(N, H));
    float NdotV = saturate(dot(N, V));

    // Diffuse
    float3 diffuse = albedo * (1.0 - metallic);

    // Specular (simplified GGX)
    float alpha = roughness * roughness;
    float alpha2 = alpha * alpha;
    float denom = NdotH * NdotH * (alpha2 - 1.0) + 1.0;
    float D = alpha2 / (3.14159 * denom * denom);

    float3 F0 = lerp(float3(0.04, 0.04, 0.04), albedo, metallic);
    float3 F = F0 + (1.0 - F0) * pow(1.0 - saturate(dot(H, V)), 5.0);

    float3 specular = D * F * 0.25;

    // Combine
    float3 directLight = (diffuse + specular) * L_sun_color * NdotL;
    float3 ambient = albedo * L_ambient.rgb * ao;

    return directLight + ambient;
}

PS_OUTPUT main(PS_INPUT input)
{
    PS_OUTPUT output;

    // Use per-draw material ID from constant buffer
    uint materialID = g_SkinnedMaterialID;

    // Get material data
    MaterialData mat = g_Materials[materialID];

    // Sample diffuse texture
    float4 diffuseSample = SampleDiffuse(mat, input.texcoord);

    // Alpha test
    if (mat.flags & MAT_FLAG_ALPHA_TEST)
    {
        clip(diffuseSample.a - mat.alphaRef);
    }

    float3 albedo = diffuseSample.rgb;

    // Normal mapping
    float3 N = normalize(input.normal);
    if (mat.flags & MAT_FLAG_HAS_NORMAL)
    {
        float3 normalSample = SampleNormal(mat, input.texcoord);
        float3x3 TBN = float3x3(
            normalize(input.tangent),
            normalize(input.bitangent),
            N
        );
        N = normalize(mul(normalSample, TBN));
    }

    // Detail texture
    if (mat.flags & MAT_FLAG_HAS_DETAIL)
    {
        float4 detailSample = SampleDetail(mat, input.texcoord);
        albedo = albedo * (detailSample.rgb * 2.0);
    }

    // PBR properties
    float metallic = 0.0;
    float roughness = 0.5;
    float ao = 1.0;

    if (mat.flags & MAT_FLAG_HAS_PBR)
    {
        float3 pbrSample = SamplePBR(mat, input.texcoord);
        metallic = pbrSample.r;
        roughness = pbrSample.g;
        ao = pbrSample.b;
    }

    // View direction
    float3 V = normalize(eye_position - input.worldPos);

    // Calculate lighting
    float3 finalColor = CalculateLighting(albedo, N, V, metallic, roughness, ao);

    output.color = float4(finalColor, diffuseSample.a);
    return output;
}
