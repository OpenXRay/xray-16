#include "common.h"
#include "sload.h"

#ifdef ATOC

float4 main( p_bumped I ) : SV_Target
{
	surface_bumped S = sload(I);
	S.base.w = (S.base.w - def_aref * 0.5f) / (1 - def_aref * 0.5f);
	return S.base;
}

#else // ATOC

f_forward main( p_bumped I )
{
	surface_bumped S = sload(I);

	// Alpha test
	clip(S.base.w - def_aref);

	// Sample normal in tangent space, transform to view space via TBN
	float3 Nv = mul(float3x3(I.M1, I.M2, I.M3), S.normal);
	Nv = normalize(Nv);

	// Transform to world space for PBR lighting
	float3 Nw = viewDirToWorld(Nv);

	// Get world position from view position
	float3 worldPos = viewPosToWorld(I.position.xyz);

	// Extract material properties from PBR textures
	float3 albedo = S.base.xyz;
	float roughness = S.roughness;
	float metallic = S.metallic;
	float ao = S.ao;

	// Get hemisphere occlusion
#ifdef USE_LM_HEMI
	float hemi = s_hemi.Sample(smp_rtlinear, I.lmh).a;
#else
	float hemi = I.position.w;
#endif

	// PBR Forward+ lighting
	return output_forward_pbr(albedo, Nw, worldPos, metallic, roughness, ao, hemi);
}

#endif // ATOC
