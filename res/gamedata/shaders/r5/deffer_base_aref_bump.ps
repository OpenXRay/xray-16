#include "common.h"
#include "sload.h"

#ifdef	ATOC

float4 	main	( p_bumped I ) : SV_Target
{
	surface_bumped 	S 		= sload 	(I);
	S.base.w = (S.base.w-def_aref*0.5f)/(1-def_aref*0.5f);
	return S.base;
}

#else	//	ATOC

f_forward 	main	( p_bumped I )
{
	surface_bumped 	S 		= sload 	(I);

	// Alpha test
	clip(S.base.w - def_aref);

	// Sample normal, rotate it by matrix
  	float3	Ne  = mul		(float3x3(I.M1, I.M2, I.M3), S.normal);
			Ne	= normalize	(Ne);

	// Extract material properties
	float3 albedo = S.base.xyz;
	float roughness = 1.0 - S.gloss;  // Convert gloss to roughness
	float metallic = 0.0;  // TODO: Sample from PBR material texture in Phase 3.1

	// Forward+ output (Phase 3.0: unlit albedo)
	return output_forward_color(albedo, Ne, metallic, roughness);
}

#endif //	ATOC
