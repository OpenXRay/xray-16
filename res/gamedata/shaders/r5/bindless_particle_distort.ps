#define SM_6_0
#include "common.h"
#include "bindless_common.h"

static const float DISTORT_STRENGTH = 0.05;

struct PS_INPUT
{
    float4 hpos     : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color    : TEXCOORD1;
    float3 worldPos : TEXCOORD2;
    float3 normal   : TEXCOORD3;
    nointerpolation uint materialID : TEXCOORD4;
};

float4 main(PS_INPUT input) : SV_Target0
{
    MaterialData mat = g_Materials[input.materialID];
    float4 distort = SampleDiffuse(mat, input.texcoord);
    float intensity = distort.a * dot(input.color.rgb, 0.33);
    float2 offset = (distort.xy - 0.5) * DISTORT_STRENGTH * intensity;
    float sourceViewZ = dot(input.worldPos - eye_position, camera_direction.xyz);
    return float4(offset, sourceViewZ * intensity, intensity);
}
