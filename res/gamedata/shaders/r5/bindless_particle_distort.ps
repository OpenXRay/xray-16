#define SM_6_0
#include "common.h"
#include "bindless_common.h"

struct PS_INPUT
{
    float4 hpos     : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color    : TEXCOORD1;
    float3 worldPos : TEXCOORD2;
    float3 normal   : TEXCOORD3;
    nointerpolation uint materialID : TEXCOORD4;
};

float4 main(PS_INPUT input) : SV_Target0
{
    MaterialData mat = g_Materials[input.materialID];
    float4 distort = float4(0, 0, 0, 0);
    if (mat.diffuseIndex != INVALID_TEXTURE_INDEX)
        distort = GetBindlessTexture(mat.diffuseIndex).Sample(smp_rtlinear, input.texcoord);
    float factor = saturate(saturate(distort.a) * dot(input.color.rgb, 0.33));
    clip(factor - 0.01);
    return float4(distort.rgb, factor);
}
