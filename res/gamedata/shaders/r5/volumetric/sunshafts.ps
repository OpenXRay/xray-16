#define SM_6_0
#define CSM_SHADOW_FORWARD
#include "common.h"
#include "shared/shadow_sampling.h"
#include "shared/surface_marks.h"

cbuffer SunShaftsCB : register(b3)
{
    float4 shaft_params;
};

Texture2D g_Depth : register(t1);
Texture2D g_WorldPos : register(t2);

struct PS_INPUT
{
    float4 position : SV_Position;
    float2 texcoord : TEXCOORD0;
};

float3 ReconstructWorldFromDepth(float2 uv, float rawDepth)
{
    float2 ndc = float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    float4 worldH = mul(m_InvVP, float4(ndc, rawDepth, 1.0));
    return worldH.xyz / max(worldH.w, 1e-5);
}

float4 main(PS_INPUT input) : SV_Target0
{
    float depth = g_Depth.SampleLevel(smp_nofilter, input.texcoord, 0).x;
    float4 worldPos4 = g_WorldPos.SampleLevel(smp_nofilter, input.texcoord, 0);

    float intensity = shaft_params.x;
    if (intensity < 1e-4)
        return float4(0.0, 0.0, 0.0, 0.0);

    int raySamples = clamp((int)shaft_params.z, 8, 48);
    float maxDensity = intensity;
    float density = maxDensity / float(raySamples);

    float res = 0.0;

    if (IsSkyDepth(depth))
    {
        res = maxDensity;
    }
    else
    {
        float3 Pw = (worldPos4.w >= 0.5 && !IsHudSurfMark(worldPos4.w))
            ? worldPos4.xyz
            : ReconstructWorldFromDepth(input.texcoord, depth);

        float3 toEye = eye_position - Pw;
        float j = frac(52.9829189 * frac(dot(input.position.xy, float2(0.06711056, 0.00583715))));
        float coeff = (float(raySamples) - j) / float(raySamples * raySamples);
        float3 stepW = toEye * coeff;

        float3 cur = Pw;
        float viewZ = abs(mul(m_V, float4(Pw, 1.0)).z);

        [loop]
        for (int i = 0; i < raySamples; ++i)
        {
            if (viewZ > 0.3)
                res += density * SampleCSM_SunShafts(cur);

            cur += stepW;
            viewZ = abs(mul(m_V, float4(cur, 1.0)).z);
        }
    }

    float3 lightTravelV = normalize(mul((float3x3)m_V, normalize(L_sun_dir_w)));
    float fSaturation = -lightTravelV.z;
    fSaturation = 0.5 * fSaturation + 0.5;
    fSaturation = 0.80 * fSaturation + 0.20;
    res *= fSaturation;

    return float4(res * L_sun_color, 0.0);
}
