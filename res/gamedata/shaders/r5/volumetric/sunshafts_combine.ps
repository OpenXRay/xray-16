#define SM_6_0
#include "common.h"

cbuffer SunShaftsCombineCB : register(b3)
{
    float4 combine_params;
};

Texture2D g_Shafts : register(t0);

struct PS_INPUT
{
    float4 position : SV_Position;
    float2 texcoord : TEXCOORD0;
};

float4 main(PS_INPUT input) : SV_Target0
{
    float2 ts = combine_params.xy;
    float3 shafts =
        g_Shafts.SampleLevel(smp_rtlinear, input.texcoord, 0).rgb * 0.5 +
        g_Shafts.SampleLevel(smp_rtlinear, input.texcoord + float2( ts.x,  ts.y), 0).rgb * 0.125 +
        g_Shafts.SampleLevel(smp_rtlinear, input.texcoord + float2(-ts.x,  ts.y), 0).rgb * 0.125 +
        g_Shafts.SampleLevel(smp_rtlinear, input.texcoord + float2( ts.x, -ts.y), 0).rgb * 0.125 +
        g_Shafts.SampleLevel(smp_rtlinear, input.texcoord + float2(-ts.x, -ts.y), 0).rgb * 0.125;

    return float4(max(shafts, 0.0), 0.0);
}
