// effects_world_soft.ps — soft depth occlusion against GBuffer worldPos (MoltenVK-safe)
Texture2D s_base : register(t0);
Texture2D g_SceneWorldPos : register(t1);
SamplerState smp_base : register(s0);

cbuffer SoftFXConstants : register(b0)
{
    float4x4 m_WVP;
    float4 EyePos;
};

struct PSInput
{
    float4 position : SV_Position;
    float4 color    : COLOR;
    float2 texcoord : TEXCOORD0;
    float3 worldPos : TEXCOORD1;
};

float4 main(PSInput input) : SV_Target
{
    float4 tex = s_base.Sample(smp_base, input.texcoord);
    float4 result = tex * input.color;

    // Soft occlusion: hide fragments behind opaque scene geometry.
    float4 sceneWP = g_SceneWorldPos.Load(int3((int2)input.position.xy, 0));
    if (sceneWP.w > 0.5)
    {
        float3 eye = EyePos.xyz;
        float sceneDist = length(sceneWP.xyz - eye);
        float fxDist = length(input.worldPos - eye);
        // Behind opaque surface → kill (with small epsilon for coplanar)
        if (fxDist > sceneDist + 0.15)
            discard;
        // Soft edge near contact
        float soft = saturate((sceneDist - fxDist + 0.15) * 4.0);
        result.a *= soft;
        result.rgb *= soft;
    }

    clip(result.a - 0.01);
    return result;
}
