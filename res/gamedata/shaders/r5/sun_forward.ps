#include "shared/common.h"

SamplerState smp_linear : register(s0);
Texture2D s_sun : register(t0);

struct PS_INPUT {
    float4 hpos     : SV_POSITION;
    float4 color    : COLOR0;
    float2 tc       : TEXCOORD0;
};

float4 main(PS_INPUT I) : SV_Target {
    float4 sunTex = s_sun.Sample(smp_linear, I.tc);

    float4 color;
    color.rgb = sunTex.rgb * I.color.rgb * 2.0;
    color.a = sunTex.a * I.color.a;

    return color;
}
