#define SM_6_0

SamplerState smp_rtlinear : register(s0);

Texture2D g_Normal  : register(t0);
Texture2D g_Patched : register(t1);

struct PS_INPUT
{
    float4 position : SV_Position;
    float2 texcoord : TEXCOORD0;
};

float4 main(PS_INPUT input) : SV_Target
{
    float4 orig = g_Normal.SampleLevel(smp_rtlinear, input.texcoord, 0);
    float4 patched = g_Patched.SampleLevel(smp_rtlinear, input.texcoord, 0);

    float wet = saturate(patched.a / 0.12);
    float wetAmt = smoothstep(0.04, 0.5, wet);
    float actorHint = saturate((patched.a - 0.24) * 3.5) * saturate(patched.a * 6.0);

    float3 No = normalize(orig.xyz + float3(0.0, 0.0, 0.00001));
    float3 Np = normalize(patched.xyz + float3(0.0, 0.0, 0.00001));
    float3 N = normalize(lerp(No, Np, wetAmt * lerp(0.85, 0.95, actorHint)));

    float up = saturate(No.y);
    float side = saturate(1.0 - abs(No.y));
    float wetRough = lerp(0.26, 0.14, up);
    wetRough = lerp(wetRough, 0.28, side * 0.55);
    float actorRough = lerp(0.1, 0.05, up);
    actorRough = lerp(actorRough, 0.09, side * 0.4);
    wetRough = lerp(wetRough, actorRough, actorHint);
    float applyAmt = wetAmt * saturate(0.6 + up * 0.4 + side * 0.4);
    applyAmt = max(applyAmt, actorHint * 0.95);
    float rough = lerp(orig.w, min(orig.w, wetRough), applyAmt * lerp(0.85, 1.0, actorHint));

    return float4(N, saturate(rough));
}
