      "inherits": [
        "win64",
        "config-rmg"
      ]
    },
    {
      "name": "win64-msvc-debug",
      "displayName": "x64 MSVC Debug",
      "inherits": [
        "win64-msvc",
        "config-debug"
      ]
    },
    {
      "name": "win64-msvc-mixed",
      "displayName": "x64 MSVC Mixed",
      "inherits": [
        "win64-msvc",
        "config-mixed"
      ]
    },
    {
      "name": "win64-msvc-release",
      "displayName": "x64 MSVC Release",
      "inherits": [
        "win64-msvc",
        "config-release"
      ]
    },
    {
      "name": "win64-msvc-rmg",
      "displayName": "x64 MSVC ReleaseMasterGold",
      "inherits": [
        "win64-msvc",
        "config-rmg"
      ]
    }
  ],
