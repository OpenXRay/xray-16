{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake_builds/${presetName}"
    },
    {
      "name": "config-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "config-mixed",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Mixed"
      }
    },
    {
      "name": "config-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "config-rmg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "ReleaseMasterGold"
      }
    },
    {
      "name": "unix",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win64",
      "hidden": true,
      "inherits": "windows",
      "toolchainFile": "${sourceDir}/cmake/toolchains/Windows.ClangCL.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "AMD64"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "win64-msvc",
      "hidden": true,
      "inherits": "windows",
      "toolchainFile": "${sourceDir}/cmake/toolchains/Windows.MSVC.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "AMD64"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "unix-debug",
      "displayName": "Debug",
      "inherits": [
        "unix",
        "config-debug"
      ]
    },
    {
      "name": "unix-mixed",
      "displayName": "Mixed",
      "inherits": [
        "unix",
        "config-mixed"
      ]
    },
    {
      "name": "unix-release",
      "displayName": "Release",
      "inherits": [
        "unix",
        "config-release"
      ]
    },
    {
      "name": "unix-rmg",
      "displayName": "ReleaseMasterGold",
      "inherits": [
        "unix",
        "config-rmg"
      ]
    },
    {
      "name": "win64-debug",
      "displayName": "x64 Debug",
      "inherits": [
        "win64",
        "config-debug"
      ]
    },
    {
      "name": "win64-mixed",
      "displayName": "x64 Mixed",
      "inherits": [
        "win64",
        "config-mixed"
      ]
    },
    {
      "name": "win64-release",
      "displayName": "x64 Release",
      "inherits": [
        "win64",
