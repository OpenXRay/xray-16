# exclude all dot files except .git, appveyor and travis files
.*
!.git*
!.appveyor*
!.editorconfig
!.vscode

# exclude binaries and temporary files
[Bb]in/
[Bb]uild*/
bin-rafx/
cmake_builds/

# Local RAFX checkouts / scratch (not vendored for this branch)
Externals/rafx/
Externals/rafx-proj/
.tmp_classic_sun/

# User-specific files
*.user
*.user.props
*.nvuser
*.PVS-Studio.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# exclude doxygen output
doc/doxygen/html/*

# Screen Space Shaders reference
refs/ssfx/
ScreenSpaceShaders_Update23_5.zip
