+    mkdir("/data/user/0/org.openxray.stalker/files/openxray", 0775);
+    mkdir("/data/data/org.openxray.stalker/files/openxray", 0775);
+
+    for (pcstr path : paths)
+        android_add_crash_log_fd(path);
+}
