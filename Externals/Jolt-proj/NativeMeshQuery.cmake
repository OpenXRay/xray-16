# Expose traversal of the pinned MeshShape BVH without changing the shared
# FetchContent checkout or adding another tree to each level collision model.
get_target_property(jolt_sources Jolt SOURCES)
foreach(source IN LISTS jolt_sources)
    if(source MATCHES "/MeshShape\\.cpp$")
        set(mesh_source "${source}")
    endif()
endforeach()
if(NOT EXISTS "${mesh_source}")
    message(FATAL_ERROR "Cannot find the pinned Jolt mesh shape")
endif()
get_filename_component(mesh_directory "${mesh_source}" DIRECTORY)
file(READ "${mesh_directory}/MeshShape.h" mesh_header)
string(FIND "${mesh_header}" "class JPH_EXPORT MeshShape final : public Shape" declaration)
if(declaration EQUAL -1)
    message(FATAL_ERROR "Jolt mesh traversal hook does not match the pinned revision")
endif()
string(REPLACE "class JPH_EXPORT MeshShape final : public Shape\n{" "class JPH_EXPORT MeshShape final : public Shape\n{\n\tfriend class XRayMeshQueries;" mesh_header "${mesh_header}")
set(mesh_overlay "${CMAKE_CURRENT_BINARY_DIR}/xray-mesh-query/include")
file(CONFIGURE OUTPUT "${mesh_overlay}/Jolt/Physics/Collision/Shape/MeshShape.h" CONTENT "${mesh_header}" @ONLY)
file(READ "${mesh_source}" mesh_implementation)
string(REPLACE "JPH_NAMESPACE_BEGIN" "#include \"XRayMeshQuery.h\"\nJPH_NAMESPACE_BEGIN" mesh_implementation "${mesh_implementation}")
string(REPLACE "JPH_NAMESPACE_END" "#include \"XRayMeshQuery.cpp.inc\"\nJPH_NAMESPACE_END" mesh_implementation "${mesh_implementation}")
set(extended_mesh "${CMAKE_CURRENT_BINARY_DIR}/xray-mesh-query/MeshShape.cpp")
file(CONFIGURE OUTPUT "${extended_mesh}" CONTENT "${mesh_implementation}" @ONLY)
list(REMOVE_ITEM jolt_sources "${mesh_source}")
list(APPEND jolt_sources "${extended_mesh}")
set_property(TARGET Jolt PROPERTY SOURCES "${jolt_sources}")
target_include_directories(Jolt BEFORE PUBLIC "${mesh_overlay}")
