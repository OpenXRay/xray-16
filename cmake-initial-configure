#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat >&2 <<USAGE
Usage: $0 [RMG|release|mixed|debug] [--vs] [--arch x64|x86]

Cleans and re-configures CMake for the current platform.

  WSL / Windows (Git Bash, MSYS2, Cygwin)  -> Ninja+Clang (default), or VS sln (--vs)
  Linux / macOS                            -> native Ninja

Configs:
  RMG       ReleaseMasterGold (default)
  release   Release
  mixed     Mixed
  debug     Debug

Flags:
  --vs              Windows-only. Generate Visual Studio sln/vcxproj instead of Ninja.
                    Prefers VS 2026 (v18) when installed, falls back to VS 2022 (v17).
                    Build dir: cmake_builds/vs_<config>[_x86]. Open <dir>/xray.sln in VS.
  --arch x64|x86    Target architecture, default x64. x86 requires --vs.

Build dir: cmake_builds/<config-lowercased>[_x86]  (or cmake_builds/vs_<config>[_x86] with --vs)
USAGE
    exit 1
}

CONFIG_INPUT=""
USE_VS=0
ARCH="x64"
expect_arch=0
for arg in "$@"; do
    if [[ $expect_arch -eq 1 ]]; then
        ARCH="$arg"; expect_arch=0; continue
    fi
    case "$arg" in
        --vs) USE_VS=1 ;;
        --arch) expect_arch=1 ;;
        --arch=*) ARCH="${arg#--arch=}" ;;
        -h|--help|help) usage ;;
        *) CONFIG_INPUT="$arg" ;;
    esac
done
case "$ARCH" in
    x64|x86) ;;
    *) echo "Unknown arch: $ARCH (expected x64 or x86)" >&2; usage ;;
esac
if [[ "$ARCH" == "x86" && $USE_VS -ne 1 ]]; then
    echo "--arch x86 currently requires --vs (Ninja+Clang path is x64-only)." >&2
    exit 1
fi
CONFIG_INPUT="${CONFIG_INPUT:-RMG}"
case "$(echo "$CONFIG_INPUT" | tr '[:upper:]' '[:lower:]')" in
    rmg|releasemastergold)  CONFIG="ReleaseMasterGold" ;;
    release|rel)            CONFIG="Release" ;;
    mixed)                  CONFIG="Mixed" ;;
    debug|dbg)              CONFIG="Debug" ;;
    *) echo "Unknown config: $CONFIG_INPUT" >&2; usage ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

arch_suffix=""
[[ "$ARCH" == "x86" ]] && arch_suffix="_x86"
if [[ $USE_VS -eq 1 ]]; then
    BUILD_DIR="cmake_builds/vs_$(echo "$CONFIG" | tr '[:upper:]' '[:lower:]')${arch_suffix}"
else
    BUILD_DIR="cmake_builds/$(echo "$CONFIG" | tr '[:upper:]' '[:lower:]')${arch_suffix}"
fi

detect_platform() {
    case "$(uname -s)" in
        Darwin) echo "macos" ;;
        Linux)
            if grep -qi microsoft /proc/version 2>/dev/null; then echo "wsl"
            else echo "linux"; fi ;;
        MINGW*|MSYS*|CYGWIN*) echo "windows" ;;
        *) echo "unknown" ;;
    esac
}

PLATFORM=$(detect_platform)

to_win_path() {
    case "$PLATFORM" in
        wsl)     wslpath -w "$1" ;;
        windows) cygpath -w "$1" ;;
    esac
}

run_cmd_file() {
    local cmd_file_win
    cmd_file_win=$(to_win_path "$1")
    case "$PLATFORM" in
        wsl)     cmd.exe /c "$cmd_file_win" ;;
        windows) cmd.exe //c "$cmd_file_win" ;;
    esac
}

configure_windows_build() {
    local c_drive
    case "$PLATFORM" in
        wsl)     c_drive="/mnt/c" ;;
        windows) c_drive="$(cygpath -u 'C:/' 2>/dev/null | sed 's#/$##')" ;;
    esac

    local vswhere="${c_drive}/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
    if [[ ! -x "$vswhere" ]]; then
        echo "vswhere not found at: $vswhere" >&2
        echo "Install Visual Studio 2026 or 2022 (or Build Tools)." >&2
        exit 1
    fi

    # Prefer the newest installed VS (VS 2026 / v18.x, then VS 2022 / v17.x) for vcvars + toolset.
    local vs_install vs_install_label
    vs_install=$("$vswhere" -version "[18.0,19.0)" -latest -property installationPath 2>/dev/null | tr -d '\r')
    if [[ -n "$vs_install" ]]; then
        vs_install_label="VS 2026"
    else
        vs_install=$("$vswhere" -version "[17.0,18.0)" -latest -property installationPath 2>/dev/null | tr -d '\r')
        if [[ -n "$vs_install" ]]; then
            vs_install_label="VS 2022"
        fi
    fi
    if [[ -z "$vs_install" ]]; then
        echo "vswhere found no VS 2026 or VS 2022 install." >&2
        exit 1
    fi

    # Pick the newest VS generator CMake actually supports (VS 2026 generator support may
    # not exist yet on older CMake; falling back to VS 2022 still works with a VS 2026 toolset).
    local cmake_help vs_generator vs_gen_label
    cmake_help=$(cmake.exe --help 2>/dev/null)
    if echo "$cmake_help" | grep -q "^[* ] *Visual Studio 18 2026"; then
        vs_generator="Visual Studio 18 2026"
        vs_gen_label="VS 2026 generator"
    elif echo "$cmake_help" | grep -q "^[* ] *Visual Studio 17 2022"; then
        vs_generator="Visual Studio 17 2022"
        vs_gen_label="VS 2022 generator"
    else
        echo "CMake reports no supported Visual Studio generator (need 2022 or newer). Update CMake." >&2
        exit 1
    fi

    local vcvars64_win="${vs_install}\\VC\\Auxiliary\\Build\\vcvars64.bat"
    local repo_win
    repo_win=$(to_win_path "$SCRIPT_DIR")

    local clang_candidates=(
        "${c_drive}/Program Files/LLVM/bin/clang.exe"
        "${c_drive}/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang.exe"
    )
    local clang_win="" p
    for p in "${clang_candidates[@]}"; do
        if [[ -x "$p" ]]; then clang_win=$(to_win_path "$p"); break; fi
    done

    if [[ -z "$clang_win" ]]; then
        echo ">> Clang not found. Installing LLVM via winget..."
        local winget_cmd="winget install --exact --id LLVM.LLVM --accept-source-agreements --accept-package-agreements"
        case "$PLATFORM" in
            wsl)     cmd.exe /c  "$winget_cmd" ;;
            windows) cmd.exe //c "$winget_cmd" ;;
        esac
        for p in "${clang_candidates[@]}"; do
            if [[ -x "$p" ]]; then clang_win=$(to_win_path "$p"); break; fi
        done
        if [[ -z "$clang_win" ]]; then
            echo "Clang install via winget failed. Install LLVM manually from https://releases.llvm.org and re-run." >&2
            exit 1
        fi
    fi
    local clangxx_win="${clang_win%clang.exe}clang++.exe"

    echo ">> Cleaning $BUILD_DIR"
    rm -rf "$BUILD_DIR"
    mkdir -p "$BUILD_DIR"

    local build_dir_win="${repo_win}\\${BUILD_DIR//\//\\}"
    local tmp_cmd="${BUILD_DIR}/_configure.cmd"

    local vs_arch="x64"
    [[ "$ARCH" == "x86" ]] && vs_arch="Win32"

    if [[ $USE_VS -eq 1 ]]; then
        echo ">> Configuring $CONFIG -> $BUILD_DIR (${vs_gen_label}, -A ${vs_arch})"
        echo ">> VS install:  $vs_install (${vs_install_label} toolset)"
        echo

        cat > "$tmp_cmd" <<CMDEOF
@echo off
call "${vcvars64_win}" >nul
if errorlevel 1 exit /b 1
cmake -G "${vs_generator}" -A ${vs_arch} ^
    -S "${repo_win}" ^
    -B "${build_dir_win}"
exit /b %ERRORLEVEL%
CMDEOF
    else
        echo ">> Configuring $CONFIG -> $BUILD_DIR ($PLATFORM -> Windows, Ninja)"
        echo ">> VS install:  $vs_install"
        echo ">> Clang C:     $clang_win"
        echo ">> Clang C++:   $clangxx_win"
        echo

        cat > "$tmp_cmd" <<CMDEOF
@echo off
call "${vcvars64_win}" >nul
if errorlevel 1 exit /b 1
cmake -G Ninja ^
    -S "${repo_win}" ^
    -B "${build_dir_win}" ^
    -DCMAKE_BUILD_TYPE=${CONFIG} ^
    -DCMAKE_C_COMPILER="${clang_win}" ^
    -DCMAKE_CXX_COMPILER="${clangxx_win}"
exit /b %ERRORLEVEL%
CMDEOF
    fi

    local rc=0
    run_cmd_file "$tmp_cmd" || rc=$?
    rm -f "$tmp_cmd"
    exit $rc
}

configure_native() {
    local label="$1"
    echo ">> Cleaning $BUILD_DIR"
    rm -rf "$BUILD_DIR"
    mkdir -p "$BUILD_DIR"

    echo ">> Configuring $CONFIG -> $BUILD_DIR ($label, native)"
    echo

    cmake -G Ninja \
        -S "$SCRIPT_DIR" \
        -B "$BUILD_DIR" \
        -DCMAKE_BUILD_TYPE="$CONFIG"
}

if [[ $USE_VS -eq 1 && "$PLATFORM" != "wsl" && "$PLATFORM" != "windows" ]]; then
    echo "--vs is Windows-only (current platform: $PLATFORM)" >&2
    exit 1
fi

case "$PLATFORM" in
    wsl|windows) configure_windows_build ;;
    linux)       configure_native "Linux" ;;
    macos)       configure_native "macOS" ;;
    *) echo "Unsupported platform: $(uname -s)" >&2; exit 1 ;;
esac
